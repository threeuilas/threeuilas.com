{
  "name": "three-uilas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "cf-typegen": "node -e \"require('node:fs').mkdirSync('.astro', { recursive: true })\" && wrangler types .astro/worker-configuration.d.ts",
    "check": "pnpm cf-typegen && astro check",
    "dev": "pnpm cf-typegen && astro dev",
    "build": "pnpm cf-typegen && astro build",
    "deploy": "pnpm build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro",
    "generate-gallery-images": "node scripts/generate-gallery-images.js",
    "optimize-images": "node scripts/optimize-images.js",
    "move-originals": "node scripts/move-originals.js"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "mimetext": "^3.0.28",
    "photoswipe": "^5.4.4",
    "resend": "^6.32.1",
    "swiper": "^14.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite-imagetools": "^12.0.1",
    "wrangler": "^4.149.0"
  }
}
