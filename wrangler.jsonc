{
	"main": "./src/worker.ts",
	"name": "threeuilas",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"queues": {
		"producers": [
			{
				"binding": "WEBSITE_LEADS_QUEUE",
				"queue": "threeuilas-website-leads-production"
			}
		]
	},
	"d1_databases": [
		{
			"binding": "CONFERENCE_DB",
			"database_name": "threeuilas-conference-production",
			"database_id": "77228fd7-cd6e-4891-91f1-9bd250e657a9",
			"migrations_dir": "migrations"
		}
	],
	"triggers": { "crons": ["*/5 * * * *"] },
	"observability": {
    "enabled": true
  },
  "vars": {},
  "routes": [
    {
      "pattern": "threeuilas.com",
      "custom_domain": true
    },
    { 
      "pattern": "www.threeuilas.com",
      "custom_domain": true
    }
  ]
}
