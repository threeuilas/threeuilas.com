{
	"main": "dist/_worker.js/index.js",
	"name": "threeuilas",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "vars": {},
  "secrets": ["RESEND_API_KEY", "TURNSTILE_SECRET_KEY"],
  "routes": [
    {
      "pattern": "threeuilas.com",
      "custom_domain": true
    },
    { 
      "pattern": "www.threeuilas.com",
      "custom_domain": true
    }
  ]
}