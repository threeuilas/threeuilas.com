{
	"main": "dist/_worker.js/index.js",
	"name": "threeuilas",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
    "enabled": true
  },
  "route": [
    {
      "pattern": "threeuilas.com/",
      "custom_domain": true,
      "zone_name": "threeuilas.com"
    },
    {
      "pattern": "www.threeuilas.com/",
      "custom_domain": true,
      "zone_name": "threeuilas.com"
    }
  ]
}