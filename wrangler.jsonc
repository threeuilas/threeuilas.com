{
	"main": "dist/_worker.js/index.js",
	"name": "threeuilas",
  "compatibility_date": "2025-12-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"queues": {
		"producers": [
			{
				"binding": "WEBSITE_LEADS_QUEUE",
				"queue": "threeuilas-website-leads-production"
			}
		]
	},
	"observability": {
    "enabled": true
  },
  "vars": {},
  "routes": [
    {
      "pattern": "threeuilas.com",
      "custom_domain": true
    },
    { 
      "pattern": "www.threeuilas.com",
      "custom_domain": true
    }
  ]
}
