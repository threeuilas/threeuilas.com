---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Three Uilas - Electric Cargo Tricycles">
	<main class="container mx-auto px-4 py-8">
		<div class="flex flex-col items-center justify-center min-h-[80vh] text-center">
			<img src="/logo.svg" alt="Three Uilas Logo" class="w-64 h-64 mb-8" />
			<h1 class="text-4xl font-bold text-gray-900 mb-4">Three Uilas</h1>
			<p class="text-xl text-gray-600">Electric cargo tricycles for sustainable urban transportation</p>
		</div>
	</main>
</Layout>
