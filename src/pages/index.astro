---
import Layout from '../layouts/Layout.astro';
import WorkhorsePhoto from '../components/WorkhorsePhoto.astro';
import ModelPreview from '../components/ModelPreview.astro';
import { availableProducts } from '../data/products';
---

<Layout title="Three Uilas | Electric Utility Tricycles in Hawaiʻi" description="Practical electric utility tricycles for life in Hawaiʻi. Explore the Workhorse Pro and Sparrow+, with local support and a 2-year parts warranty." ogImage="/workhorse-pro/front-right-road-action-1920.webp">
	<section class="home-hero" aria-labelledby="home-title">
		<div class="hero-copy">
			<p class="ui-eyebrow">Electric utility, Hawaiʻi</p>
			<h1 id="home-title">ELECTRIC.<br />READY TO<br /><span>WORK.</span></h1>
			<p class="body-copy">Practical electric tricycles for your home, farm, and everyday hauling.</p>
			<a href="/products" class="action">Explore our models</a>
		</div>
		<div class="hero-photo"><WorkhorsePhoto name="front-right-road-action" sizes="(max-width: 700px) 100vw, 60vw" priority /><p>THE WORKHORSE PRO <span>100% electric utility</span></p></div>
	</section>

	<div class="benefits-strip"><div class="site-width"><p>All electric<span>Plug in with the included wall charger</span></p><p>Built for real work<span>All-steel construction. Easy to maintain.</span></p><p>Locally owned and operated<span>Based in Hilo, Hawaiʻi</span></p></div></div>

	<section class="site-width section-pad" aria-labelledby="models-title">
		<div class="section-top"><div><p class="ui-eyebrow">The lineup</p><h2 id="models-title" class="display-heading">FIND YOUR UILA.</h2></div><a href="/products" class="inline-link">Compare all models</a></div>
		<div class="model-grid">{availableProducts.map(product => <ModelPreview product={product} />)}</div>
		<p class="range-footnote">*Maximum range varies with load, terrain, and driving conditions.</p>
	</section>

	<section class="local-section" aria-labelledby="local-title"><div class="site-width local-grid">
		<div class="local-photo"><WorkhorsePhoto name="front-right-far-action" sizes="(max-width: 700px) 100vw, 40vw" /></div>
		<div class="local-copy"><p class="ui-eyebrow">Based in Hilo</p><h2 id="local-title" class="display-heading">FROM HERE.<br />HERE TO HELP.</h2><p class="body-copy">We’re a Hawaiʻi-based business offering electric utility tricycles at an affordable price. We can help you choose a model, arrange delivery, and find parts when you need them.</p><a href="/about" class="inline-link">Our story</a></div>
	</div></section>

	<section class="inquiry-band" aria-labelledby="inquiry-title"><div class="site-width"><div><h2 id="inquiry-title">Have a job in mind?</h2><p class="body-copy">Tell us about your property and what you need to move.</p></div><a href="/contact" class="action">Get in touch</a></div></section>
</Layout>

<style>
	.home-hero { display: grid; grid-template-columns: .9fr 1.1fr; min-height: 650px; }
	.hero-copy { align-self: center; padding: 65px 45px 70px max(56px, calc((100vw - 1280px) / 2)); }
	h1 { font-size: clamp(76px, 7.6vw, 118px); font-weight: 800; line-height: .9; letter-spacing: -.035em; }
	h1 span { color: #738066; }
	.hero-copy > .body-copy { margin: 28px 0; max-width: 330px; }
	.hero-photo { position: relative; overflow: hidden; background: #34402e; }
	.hero-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 58% center; }
	.hero-photo > p { position: absolute; inset: auto 0 0; display: flex; align-items: center; justify-content: space-between; gap: 20px; padding: 50px 32px 28px; background: linear-gradient(transparent, #172112c9); font-size: 17px; font-weight: 600; color: white; }
	.hero-photo > p span { font: 10px/1.6 system-ui, sans-serif; font-weight: 400; color: #e2e7d9; }
	.benefits-strip { background: #e7e9df; }
	.benefits-strip > div { display: grid; grid-template-columns: repeat(3, 1fr); padding-block: 29px; gap: 28px; }
	.benefits-strip p { font-size: 22px; font-weight: 600; padding-left: 28px; border-left: 1px solid #c5ccba; }
	.benefits-strip p:first-child { border: 0; padding-left: 0; }
	.benefits-strip p span { display: block; margin-top: 7px; font: 11px/1.7 system-ui, sans-serif; color: #626c57; }
	.model-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
	.range-footnote { font: 10px/1.8 system-ui, sans-serif; color: #6b745f; margin-top: 28px; }
	.local-section { background: #283325; color: #f5f4ef; padding-block: 72px; }
	.local-grid { display: grid; grid-template-columns: .85fr 1fr; gap: clamp(48px, 8vw, 120px); align-items: center; }
	.local-photo :global(img) { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center 60%; }
	.local-copy .ui-eyebrow { color: #c2ccb7; }
	.local-copy .body-copy { color: #c6cfbd; max-width: 450px; margin: 28px 0; }
	.local-copy .inline-link:hover { color: #d5e0ca; }
	@media (max-width: 1050px) { .home-hero { min-height: 590px; } .hero-copy { padding-left: 32px; padding-right: 30px; } h1 { font-size: 86px; } .model-grid { gap: 30px; } .hero-photo > p { padding-inline: 24px; } }
	@media (max-width: 700px) {
		.home-hero { grid-template-columns: 1fr; min-height: 0; }
		.hero-copy { padding: 45px 20px 42px; }
		h1 { font-size: clamp(76px, 16vw, 110px); }
		.hero-copy > .body-copy { margin: 23px 0; max-width: 350px; }
		.hero-photo { height: 390px; }
		.hero-photo :global(img) { object-position: center; }
		.hero-photo > p { padding: 35px 20px 20px; }
		.benefits-strip > div { grid-template-columns: 1fr; gap: 18px; padding-block: 26px; }
		.benefits-strip p { padding-left: 0; padding-top: 18px; border-left: 0; border-top: 1px solid #c5ccba; font-size: 21px; }
		.benefits-strip p:first-child { padding-top: 0; }
		.benefits-strip p span { margin-top: 3px; }
		.model-grid { grid-template-columns: 1fr; gap: 48px; }
		.local-section { padding-block: 40px 52px; }
		.local-grid { grid-template-columns: 1fr; gap: 35px; }
		.local-photo :global(img) { aspect-ratio: 5 / 4; }
	}
</style>
