---
import Layout from '../layouts/Layout.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import { availableProducts } from '../data/products';

const productImages = [
	'/gallery/workhorse/workhorse-red-front.webp',
	'/gallery/workhorse/workhorse-red-side-view.webp',
	'/gallery/sparrow/sparrow-front.webp',
	'/gallery/workhorse/workhorse-3-colors-1.webp',
	'/gallery/workhorse/workhorse-green-side-dump.webp',
	'/gallery/sparrow/sparrow-side.webp',
];
---

<Layout title="Three Uilas - Quality Electric Tricycles for All" description="Workhorse Pro and Sparrow+ electric tricycles are available for purchase now. Compare models, pricing, and lithium battery specifications from Hawaiʻi-based Three Uilas.">
	<!-- Hero Section -->
	<section class="bg-[#DB1100] text-[#FDFDFC] py-6 md:py-12 lg:py-16 relative overflow-hidden">
		<div class="container mx-auto px-4 sm:px-6">
			<div class="max-w-6xl mx-auto">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 lg:gap-12 items-center">
					<!-- Company Slogan - Left Side -->
					<div class="text-center lg:text-left order-2 lg:order-1 lg:max-w-lg">
						<h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold text-[#FDFDFC] mb-3 md:mb-4">Quality electric tricycles for all</h1>
						<p class="text-base sm:text-lg md:text-xl lg:text-2xl text-[#FDFDFC]/90 font-medium mb-6 md:mb-8">Providing Hawaiʻi with high quality personal and farm vehicles at an affordable price</p>
						<p class="text-base sm:text-lg font-semibold mb-6">Workhorse Pro and Sparrow+ are available for purchase now.</p>
						<div class="flex flex-col sm:flex-row gap-3 md:gap-4 justify-center lg:justify-start">
							<a href="/products" class="bg-[#FDFDFC] text-[#DB1100] px-6 md:px-8 py-2.5 md:py-3 rounded font-medium hover:bg-[#FDFDFC]/90 transition-colors inline-block text-sm md:text-base text-center">
								Compare Available Models
							</a>
							<a href="/contact" class="border-2 border-[#FDFDFC] text-[#FDFDFC] bg-transparent px-6 md:px-8 py-2.5 md:py-3 rounded font-medium hover:bg-[#FDFDFC]/10 transition-colors inline-block text-sm md:text-base text-center">
								Contact Us
							</a>
						</div>
					</div>
					
					<!-- Product image carousel - Right Side -->
					<div class="order-1 lg:order-2">
						<div class="max-w-xl mx-auto lg:mx-0 rounded-2xl shadow-2xl ring-4 ring-[#FDFDFC]/20 overflow-hidden">
							<ProductCarousel images={productImages} alt="Three Uilas electric tricycle" priority={true} />
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	
	<!-- Models available for purchase -->
	<section class="bg-gray-900 text-white py-8 md:py-12 lg:py-16" aria-labelledby="available-models-heading">
		<div class="container mx-auto px-4 sm:px-6">
			<div class="max-w-6xl mx-auto">
				<div class="flex justify-center mb-4 md:mb-6">
					<span class="bg-blue-600 text-white text-sm font-semibold px-5 py-2 rounded-full uppercase tracking-wide">Available for Purchase Now</span>
				</div>
				<h2 id="available-models-heading" class="text-center text-3xl sm:text-4xl md:text-5xl font-bold mb-4">Workhorse Pro &amp; Sparrow+</h2>
				<p class="text-center text-gray-300 text-lg mb-8">Compare our available models, then contact us to arrange your purchase.</p>
				<div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
					{availableProducts.map((product) => (
						<article class="border border-gray-700 rounded-lg p-6 md:p-8 flex flex-col">
							<h3 class="text-2xl md:text-3xl font-bold mb-3">{product.name.replace('Three Uilas ', '')}</h3>
							<p class="text-gray-300 text-lg mb-6">{product.description}</p>
							<dl class="grid grid-cols-2 gap-5 mb-6">
								{['Battery Capacity', 'Battery System', 'Maximum Range', 'Motor'].map((label) => (
									<div>
										<dt class="text-gray-400 text-sm mb-1">{label}</dt>
										<dd class="text-lg font-semibold text-blue-300">{product.specs.find((spec) => spec.label === label)?.value}</dd>
									</div>
								))}
							</dl>
							<p class="text-white text-3xl font-bold mb-5 mt-auto">${product.pricing.discountedPrice.toLocaleString()}</p>
							<a href={`/contact?vehicle=${encodeURIComponent(product.name)}`} class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded font-medium transition-colors text-center">
								Contact to Purchase {product.name.replace('Three Uilas ', '')} →
							</a>
						</article>
					))}
				</div>
				<p class="text-center mt-6"><a href="/products" class="text-blue-300 underline hover:text-white transition-colors">View full specifications and features →</a></p>
			</div>
		</div>
	</section>

	<!-- Key Features -->
	<section class="py-8 md:py-12 lg:py-16 bg-[#FDFDFC]">
		<div class="container mx-auto px-4 sm:px-6">
			<div class="max-w-6xl mx-auto">
				<div class="flex flex-col md:flex-row md:items-center gap-6 md:gap-8 lg:gap-12">
					<!-- Title on the right (appears first on mobile, right on desktop) -->
					<div class="md:text-right md:shrink-0 order-1 md:order-2">
						<h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-gray-800">Why Choose Three Uilas?</h2>
					</div>
					<!-- List on the left (appears second on mobile, left on desktop) -->
					<div class="space-y-4 md:space-y-6 flex-1 md:max-w-[60%] order-2 md:order-1">
						<div>
							<h3 class="font-semibold text-base md:text-lg mb-1.5 md:mb-2 text-gray-800">Locally Owned</h3>
							<p class="text-base md:text-lg text-gray-600">Hawaiʻi-based business committed to serving our community</p>
						</div>
						<div>
							<h3 class="font-semibold text-base md:text-lg mb-1.5 md:mb-2 text-gray-800">Competitive Pricing</h3>
							<p class="text-base md:text-lg text-gray-600">Affordable quality without compromising on reliability or performance</p>
						</div>
						<div>
							<h3 class="font-semibold text-base md:text-lg mb-1.5 md:mb-2 text-gray-800">Easy to Repair & Modify</h3>
							<p class="text-base md:text-lg text-gray-600">User-serviceable design with all-steel construction for easy maintenance</p>
						</div>
						<div>
							<h3 class="font-semibold text-base md:text-lg mb-1.5 md:mb-2 text-gray-800">2-Year Warranty & Local Support</h3>
							<p class="text-base md:text-lg text-gray-600">Comprehensive parts warranty with local support for peace of mind</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-8 md:py-12 lg:py-16 bg-[#DB1100] text-[#FDFDFC]">
		<div class="container mx-auto px-4 sm:px-6 text-center">
			<h2 class="text-2xl sm:text-3xl font-bold mb-3 md:mb-4">Ready to get started?</h2>
			<p class="text-lg sm:text-xl mb-6 md:mb-8 text-[#FDFDFC]/80">Explore our range of electric cargo tricycles</p>
			<a href="/products" class="bg-[#FDFDFC] text-[#DB1100] px-6 md:px-8 py-2.5 md:py-3 rounded font-medium hover:bg-[#FDFDFC]/90 transition-colors inline-block text-sm md:text-base">
				Browse Products
			</a>
		</div>
	</section>
</Layout>
