---
import Layout from '../../layouts/Layout.astro';
import QuestionList from '../../components/QuestionList.astro';
import WorkhorsePhoto from '../../components/WorkhorsePhoto.astro';
import WorkhorseFeatures from '../../components/WorkhorseFeatures.astro';
import ProductColors from '../../components/ProductColors.astro';
import { workhorsePro as product } from '../../data/products';
import { workhorsePhotos, type WorkhorsePhotoName } from '../../data/workhorse-pro';

const price = `$${product.pricing.discountedPrice.toLocaleString('en-US')}`;
const contactLink = `/contact?vehicle=${encodeURIComponent(product.name)}`;
const spec = (label: string) => product.specs.find(item => item.label === label)?.value;
const stats = [
	{ value: spec('Motor')?.replace('W', ''), unit: 'W', label: 'Electric motor' },
	{ value: spec('Battery Capacity')?.split(' ')[0], unit: 'kWh', label: 'Lithium battery' },
	{ value: spec('Bed Size')?.replace('ft', ''), unit: 'ft', label: 'Hydraulic dump bed' },
	{ value: spec('Maximum Range')?.split(' ')[0], unit: 'mi*', label: 'Maximum range' },
];
const gallery: { name: WorkhorsePhotoName; caption: string }[] = [
	{ name: 'front-right-road-action', caption: 'On the road' },
	{ name: 'rear-action', caption: 'Rear view' },
	{ name: 'rear-right-close', caption: 'Steel cargo bed' },
	{ name: 'rear-right-dump-wide', caption: 'Hydraulic dump bed' },
];
const specifications = [
	{ title: 'Power & range', rows: [
		['Motor', spec('Motor')],
		['Battery chemistry', 'Lithium iron phosphate (LiFePO₄)'],
		['Battery voltage', '72V'],
		['Battery capacity', spec('Battery Capacity')],
		['Maximum range', `Up to ${spec('Maximum Range')}*`],
		['Top speed', spec('Top Speed')],
		['Charging', 'Included plug-in wall charger'],
	] },
	{ title: 'Work & everyday use', rows: [
		['Cargo bed length', '5 ft'],
		['Bed lift', 'Hydraulic auto-dump, included'],
		['Construction', 'All-steel'],
		['Cabin', 'Roof and partial wind/rain screen'],
		['Lighting', 'High-brightness LED headlights'],
		['Tow hitch', '2" hitch ball'],
		['Warranty', '2-year parts warranty'],
	] },
];
const faqs = [
	{ question: 'How do I charge it?', answer: 'Every Workhorse Pro includes a wall charger that plugs into the vehicle. Contact us if you have questions about the power supply at your charging location.' },
	{ question: 'What affects the range?', answer: 'The maximum range is up to 120 miles. Load, hills, rough surfaces, and driving conditions affect actual range. Flat, paved routes extend range compared with hilly or uneven terrain.' },
	{ question: 'Is it intended for public roads?', answer: 'The Workhorse Pro is intended for private property, private roads, and off-road use. It is not sold as a street-legal vehicle.' },
	{ question: 'What is included in the price?', answer: 'The Workhorse Pro includes the hydraulic dump bed, 10.1 kWh lithium iron phosphate battery, wall charger, partial wind/rain screen, upgraded headlights, tow hitch, and a 2-year parts warranty.' },
	{ question: 'Can you deliver it?', answer: 'Delivery is available for an additional fee. Include your delivery location when you contact us so we can provide a quote.' },
];
---

<Layout
	title="Workhorse Pro | Electric Utility Tricycle | Three Uilas"
	description={`Meet the Three Uilas Workhorse Pro: an all-electric utility tricycle with a 5 ft hydraulic dump bed, ${spec('Motor')} motor, and ${spec('Battery Capacity')} lithium battery. ${price}.`}
	ogImage="/workhorse-pro/cabin-front-wide-1920.webp"
>
	<div class="workhorse-page">
		<section class="hero" aria-labelledby="product-title">
			<WorkhorsePhoto name="cabin-front-wide" sizes="100vw" priority class="hero-photo" />
			<div class="hero-shade" aria-hidden="true"></div>
			<div class="hero-content page-width">
				<a class="breadcrumb" href="/products">Products / Workhorse Pro</a>
				<div class="hero-heading">
					<p class="eyebrow light"><span class="red-line" aria-hidden="true"></span> Electric utility tricycle</p>
					<h1 id="product-title" aria-label="Workhorse Pro">WORKHORSE<br />PRO<span class="red-period">.</span></h1>
					<p class="hero-tagline">Electric hauling for your property.</p>
				</div>
				<div class="hero-bottom">
					<div class="hero-purchase">
						<p><span class="hero-price">{price}</span><span class="price-note">Hydraulic dump bed included</span></p>
						<a href={contactLink} class="pro-button">Ask about the Pro</a>
					</div>
				</div>
			</div>
		</section>

		<nav class="product-nav" aria-label="Workhorse Pro sections">
			<div class="page-width product-nav-inner">
				<a href="#page-top" class="product-nav-name" aria-label="Back to top of Workhorse Pro page">WORKHORSE <strong>PRO.</strong></a>
				<div class="product-nav-links">
					<a href="#overview">Overview</a>
					<a href="#features">Features</a>
					<a href="#gallery">Gallery</a>
					<a href="#specifications">Specs</a>
				</div>
				<a href={contactLink} class="nav-purchase">Contact us</a>
			</div>
		</nav>

		<section class="stats-section" aria-label="Workhorse Pro highlights">
			<div class="page-width">
				<dl class="stats">
					{stats.map(stat => (
						<div><dt>{stat.label}</dt><dd>{stat.value}<span>{stat.unit}</span></dd></div>
					))}
				</dl>
				<p class="range-note">*Up to 120 miles. Actual range varies with load, terrain, and driving conditions.</p>
			</div>
		</section>

		<section id="overview" class="overview page-width section-space" aria-labelledby="overview-title">
			<div class="overview-image">
				<WorkhorsePhoto name="front-right-far-action" sizes="(max-width: 700px) 100vw, 40vw" />
			</div>
			<div class="overview-copy">
				<p class="eyebrow"><span class="red-line" aria-hidden="true"></span> Meet the Workhorse Pro</p>
				<h2 id="overview-title">MADE FOR<br /><span class="muted-heading">DAILY WORK.</span></h2>
				<p class="overview-intro">An electric utility tricycle for hauling tools, harvest, feed, and materials around your property.</p>
				<p>The Workhorse Pro pairs a five-foot steel bed with a hydraulic lift, a 1,800W motor, and a 10.1 kWh lithium battery.</p>
				<ProductColors colors={product.colors} />
				<div class="overview-footnote"><p>Local support in Hawaiʻi.<br /><strong>2-year parts warranty included.</strong></p></div>
			</div>
		</section>

		<section id="features" class="features-section section-space" aria-labelledby="features-title">
			<div class="page-width">
				<div class="section-heading">
					<div><p class="eyebrow">Features</p><h2 id="features-title">BUILT TO BE USEFUL.</h2></div>
				</div>
				<WorkhorseFeatures />
			</div>
		</section>

		<section id="gallery" class="gallery-section section-space" aria-labelledby="gallery-title">
			<div class="page-width">
				<div class="section-heading">
					<div><p class="eyebrow light">Gallery</p><h2 id="gallery-title">A CLOSER LOOK.</h2></div>
				</div>
				<div class="pro-gallery" aria-label="Workhorse Pro photo gallery">
					{gallery.map((photo, index) => (
						<a href={`/workhorse-pro/${photo.name}-1920.webp`} class={`gallery-photo gallery-photo-${index + 1}`} data-pswp-width="1920" data-pswp-height={workhorsePhotos[photo.name].portrait ? 2880 : 1280} data-cropped="true" target="_blank" rel="noopener" aria-label={`Enlarge photo: ${photo.caption}`}>
							<WorkhorsePhoto name={photo.name} sizes={index === 0 ? '(max-width: 700px) 100vw, 70vw' : '(max-width: 700px) 50vw, 35vw'} />
							<span class="gallery-caption">{photo.caption}<span aria-hidden="true">+</span></span>
						</a>
					))}
				</div>
				<p class="gallery-hint">Select a photo to view full screen.</p>
			</div>
		</section>

		<section id="specifications" class="specifications section-space page-width" aria-labelledby="specs-title">
			<div class="section-heading">
				<div><p class="eyebrow">Technical details</p><h2 id="specs-title">SPECIFICATIONS.</h2></div>
			</div>
			<div class="spec-groups">
				{specifications.map(group => (
					<div><h3>{group.title}</h3><dl>{group.rows.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div>
				))}
			</div>
			<p class="spec-note">*Maximum range is up to 120 miles. Actual range depends on load, terrain, and driving conditions. Intended for private property, private roads, and off-road use.</p>
		</section>

		<section class="faq-section page-width" aria-labelledby="faq-title">
			<div><p class="eyebrow">Ownership</p><h2 id="faq-title">COMMON<br />QUESTIONS.</h2><a href="/products" class="editorial-link">Compare all models</a></div>
			<QuestionList questions={faqs} />
		</section>

		<section class="purchase-section" aria-labelledby="purchase-title">
			<div class="purchase-photo"><WorkhorsePhoto name="cabin-front-wide" sizes="(max-width: 800px) 100vw, 55vw" /></div>
			<div class="purchase-copy">
				<p class="eyebrow light">Available now</p>
				<h2 id="purchase-title">WORKHORSE<br />PRO.</h2>
				<p class="purchase-price">{price}<span>Workhorse Pro</span></p>
				<p>Includes the hydraulic dump bed, lithium battery, and wall charger.</p>
				<a href={contactLink} class="pro-button">Contact us about the Pro</a>
				<p class="delivery-note">Delivery available.</p>
			</div>
		</section>
	</div>
</Layout>

<script>
	import PhotoSwipeLightbox from 'photoswipe/lightbox';
	import 'photoswipe/style.css';

	const lightbox = new PhotoSwipeLightbox({
		gallery: '.pro-gallery',
		children: 'a',
		bgOpacity: 0.96,
		pswpModule: () => import('photoswipe'),
	});
	lightbox.init();
</script>

<style>
	.workhorse-page { background: #f5f4ef; color: #252a22; }
	.page-width { width: min(1280px, calc(100% - 112px)); margin-inline: auto; }
	.section-space { padding-block: 100px; }
	[id] { scroll-margin-top: 84px; }
	h2 { font-size: clamp(38px, 4.3vw, 66px); font-weight: 800; letter-spacing: -.025em; line-height: 1.02; }
	.eyebrow { display: flex; align-items: center; gap: 12px; font-family: system-ui, sans-serif; font-size: 10px; font-weight: 650; text-transform: uppercase; letter-spacing: .15em; line-height: 1.6; margin-bottom: 22px; color: #64695e; }
	.eyebrow.light { color: #e0e3d7; }
	.red-line { display: inline-block; width: 26px; height: 3px; background: #db1100; flex-shrink: 0; }
	.hero { position: relative; min-height: 680px; height: min(790px, calc(100svh - 88px)); color: white; background: #33382b; overflow: hidden; }
	.hero :global(.hero-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 64%; }
	.hero-shade { position: absolute; inset: 0; background: linear-gradient(90deg, rgb(12 22 14 / 81%) 0%, rgb(12 22 14 / 52%) 29%, rgb(12 22 14 / 5%) 62%), linear-gradient(0deg, rgb(10 18 12 / 70%), transparent 35%); }
	.hero-content { position: relative; display: flex; flex-direction: column; height: 100%; min-height: inherit; padding-top: 27px; padding-bottom: 40px; }
	.breadcrumb { font-family: system-ui, sans-serif; font-size: 10px; letter-spacing: .04em; color: #e0e3d7; align-self: start; }
	.hero-heading { margin-top: auto; margin-bottom: auto; padding-top: 34px; }
	.hero h1 { font-size: clamp(80px, 8.8vw, 140px); font-weight: 800; line-height: .84; letter-spacing: -.035em; margin-left: -4px; }
	.red-period { color: #f02b1a; }
	.hero-tagline { font-size: 23px; margin-top: 25px; }
	.hero-bottom { display: flex; justify-content: space-between; align-items: end; gap: 24px; }
	.hero-purchase { display: flex; align-items: center; gap: 30px; }
	.hero-price { font-size: 34px; font-weight: 600; display: block; line-height: 1.15; }
	.price-note { font-family: system-ui, sans-serif; color: #dedfd8; font-size: 10px; }
	.pro-button { display: inline-flex; justify-content: space-between; align-items: center; gap: 40px; min-height: 52px; padding: 16px 26px; background: #db1100; color: white; font-family: system-ui, sans-serif; font-size: 12px; font-weight: 650; text-decoration: none; transition: background .15s; }
	.pro-button:hover { background: #b80e00; }
	.product-nav { position: sticky; top: 0; z-index: 30; background: #f5f4ef; border-bottom: 1px solid #d9dad1; }
	.product-nav-inner { display: flex; align-items: center; justify-content: space-between; min-height: 68px; gap: 24px; }
	.product-nav-name { font-size: 20px; font-weight: 600; white-space: nowrap; }
	.product-nav-name strong { color: #b80e00; }
	.product-nav-links { display: flex; gap: 34px; }
	.product-nav-links a { padding-block: 23px; font-size: 15px; color: #575c51; }
	.product-nav-links a:hover { color: #b80e00; }
	.nav-purchase { font-size: 16px; font-weight: 600; display: flex; gap: 30px; align-items: center; }
	.stats-section { background: #e9eae2; padding-block: 38px 20px; }
	.stats { display: grid; grid-template-columns: repeat(4, 1fr); }
	.stats > div { display: flex; flex-direction: column-reverse; padding: 0 40px; border-left: 1px solid #c9ccbf; }
	.stats > div:first-child { padding-left: 0; border-left: 0; }
	.stats dd { font-size: clamp(40px, 4.5vw, 68px); line-height: 1; font-weight: 600; letter-spacing: -.025em; }
	.stats dd span { margin-left: 6px; font-size: 23px; font-weight: 400; letter-spacing: 0; }
	.stats dt { font-family: system-ui, sans-serif; font-size: 10px; color: #565e4f; margin-top: 12px; }
	.range-note { font-family: system-ui, sans-serif; font-size: 9px; line-height: 1.6; color: #656c5c; margin-top: 27px; text-align: right; }
	.overview { display: grid; grid-template-columns: .85fr 1fr; gap: clamp(50px, 8vw, 130px); align-items: center; }
	.overview-image { position: relative; }
	.overview-image :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 57%; }
	.overview h2 { font-size: clamp(46px, 5.2vw, 78px); margin-bottom: 28px; }
	.muted-heading { color: #707c62; }
	.overview-copy > p:not(.eyebrow) { font-family: system-ui, sans-serif; font-size: 14px; line-height: 1.8; color: #606557; max-width: 460px; margin-bottom: 16px; }
	.overview-copy > .overview-intro { font-size: 17px !important; color: #353d2c !important; }
	.editorial-link { display: inline-flex; gap: 28px; align-items: center; font-size: 17px; font-weight: 600; padding-block: 8px; border-bottom: 1px solid currentColor; text-decoration: none; }
	.overview-footnote { display: flex; align-items: center; gap: 20px; border-top: 1px solid #d7d9cf; margin-top: 32px; padding-top: 23px; }
	.overview-footnote p { font-family: system-ui, sans-serif; font-size: 11px; line-height: 1.8; color: #626857; }
	.overview-footnote strong { color: #353d2c; font-weight: 500; }
	.features-section { padding-top: 0; }
	.section-heading { display: flex; align-items: end; justify-content: space-between; gap: 40px; margin-bottom: 38px; }
	.section-heading .eyebrow { margin-bottom: 13px; }
	.section-heading > p { font-family: system-ui, sans-serif; font-size: 12px; line-height: 1.8; color: #686e5f; flex-shrink: 0; }
	.gallery-section { background: #252f24; color: #f5f4ef; }
	.gallery-section .section-heading > p { color: #b9c3b0; }
	.gallery-section h2 { font-size: clamp(36px, 3.9vw, 60px); }
	.pro-gallery { display: grid; grid-template-columns: 1fr 1fr 1fr; grid-template-rows: auto auto; gap: 18px; }
	.gallery-photo { position: relative; display: block; overflow: hidden; background: #34402f; }
	.gallery-photo :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .4s; }
	.gallery-photo:hover :global(img) { transform: scale(1.025); }
	.gallery-photo-1 { grid-column: span 2; aspect-ratio: 3 / 2; }
	.gallery-photo-2 { grid-column: 3; grid-row: span 2; }
	.gallery-photo-2 :global(img) { object-position: center; }
	.gallery-photo-3, .gallery-photo-4 { aspect-ratio: 3 / 2; }
	.gallery-caption { position: absolute; inset: auto 0 0; display: flex; justify-content: space-between; align-items: end; padding: 40px 22px 20px; background: linear-gradient(transparent, #10190ee6); font-size: 17px; }
	.gallery-caption > span { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid #ffffff70; flex-shrink: 0; margin-left: 16px; }
	.gallery-hint { font-family: system-ui, sans-serif; font-size: 10px; color: #c0c9b9; margin-top: 22px; }
	.gallery-hint span { margin-left: 10px; }
	.spec-groups { display: grid; grid-template-columns: 1fr 1fr; gap: 64px; }
	.spec-groups h3 { font-size: 26px; font-weight: 600; padding-bottom: 18px; border-bottom: 2px solid #343e2c; }
	.spec-groups dl > div { display: flex; justify-content: space-between; gap: 24px; padding-block: 17px; border-bottom: 1px solid #d8dbcf; font-family: system-ui, sans-serif; font-size: 12px; line-height: 1.6; }
	.spec-groups dt { color: #646b5b; }
	.spec-groups dd { text-align: right; max-width: 65%; font-weight: 500; }
	.spec-note { margin-top: 24px; font-family: system-ui, sans-serif; font-size: 10px; line-height: 1.8; color: #68715e; }
	.faq-section { display: grid; grid-template-columns: .85fr 1.4fr; gap: 80px; padding-bottom: 100px; }
	.faq-section h2 { font-size: clamp(40px, 4vw, 58px); }
	.faq-section .editorial-link { margin-top: 24px; }
	.purchase-section { display: grid; grid-template-columns: 1.1fr 1fr; background: #e8e9df; }
	.purchase-photo :global(img) { width: 100%; height: 100%; min-height: 530px; object-fit: cover; object-position: 57% center; }
	.purchase-copy { padding: 64px clamp(32px, 5vw, 88px); background: #2a3426; color: #f5f4ef; }
	.purchase-copy h2 { font-size: clamp(56px, 5.3vw, 80px); margin-bottom: 26px; }
	.purchase-price { display: flex; align-items: baseline; gap: 17px; font-size: 40px; font-weight: 600; margin-bottom: 14px; }
	.purchase-price span { font-size: 18px; font-weight: 400; color: #cad1c1; }
	.purchase-copy > p:not(.eyebrow, .purchase-price) { font-family: system-ui, sans-serif; font-size: 12px; line-height: 1.9; color: #c7cfbf; }
	.purchase-copy .pro-button { margin-top: 24px; min-width: 240px; }
	.purchase-copy > .delivery-note { font-size: 10px !important; margin-top: 13px; }
	a:focus-visible, summary:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
	.hero a:focus-visible, .gallery-section a:focus-visible, .purchase-section a:focus-visible { outline-color: white; }
	@media (min-width: 1800px) { .hero :global(.hero-photo) { object-position: center 70%; } }
	@media (max-width: 1050px) {
		.page-width { width: calc(100% - 64px); }
		.hero { min-height: 620px; }
		.hero-purchase { gap: 20px; }
		.stats > div { padding-inline: 24px; }
		.overview { gap: 48px; }
		.overview h2 { font-size: 58px; }
		.overview-image :global(img) { aspect-ratio: 3 / 4; }
		.spec-groups { gap: 32px; }
		.section-heading > .editorial-link { max-width: 180px; }
	}
	@media (max-width: 800px) {
		.section-space { padding-block: 70px; }
		.features-section { padding-top: 0; }
		.hero { height: 680px; min-height: 0; }
		.hero :global(.hero-photo) { object-position: 57% center; }
		.hero-heading { padding-top: 50px; }
		.hero h1 { font-size: 92px; }
		.hero-purchase { width: 100%; justify-content: space-between; }
		.product-nav-name { display: none; }
		.product-nav-inner { min-height: 60px; }
		.product-nav-links { gap: 24px; }
		.product-nav-links a { padding-block: 20px; }
		.stats dd { font-size: 46px; }
		.stats dd span { font-size: 18px; }
		.stats > div { padding-inline: 18px; }
		.overview { gap: 32px; }
		.overview h2 { font-size: 44px; }
		.overview-copy > p:not(.eyebrow) { font-size: 12px; }
		.overview-copy > .overview-intro { font-size: 15px !important; }
		.overview-image :global(img) { aspect-ratio: 2 / 3; }
		.overview-footnote { margin-top: 20px; padding-top: 16px; }
		.section-heading { gap: 24px; }
		.section-heading > p { display: none; }
		.pro-gallery { gap: 12px; }
		.gallery-caption { font-size: 14px; padding: 30px 12px 12px; }
		.faq-section { gap: 40px; padding-bottom: 70px; }
		.purchase-section { grid-template-columns: 1fr; }
		.purchase-photo :global(img) { min-height: 0; height: 430px; object-position: center 64%; }
		.purchase-copy { padding: 50px 32px; }
	}
	@media (max-width: 600px) {
		.page-width { width: calc(100% - 40px); }
		.section-space { padding-block: 56px; }
		.hero { height: 760px; max-height: none; }
		.hero :global(.hero-photo) { height: 69%; top: 31%; object-position: 59% center; }
		.hero-shade { background: linear-gradient(180deg, #1a2619 0%, #1a2619 27%, rgb(26 38 25 / 15%) 50%, transparent 65%, rgb(13 23 13 / 95%) 100%); }
		.hero-content { padding-top: 20px; padding-bottom: 25px; }
		.breadcrumb { font-size: 9px; }
		.hero-heading { margin-top: 40px; margin-bottom: auto; padding-top: 0; }
		.hero h1 { font-size: clamp(60px, 18vw, 108px); }
		.hero .eyebrow { font-size: 9px; margin-bottom: 20px; }
		.hero-tagline { font-size: 19px; margin-top: 18px; }
		.hero-purchase { gap: 12px; }
		.hero-price { font-size: 32px; }
		.price-note { display: block; font-size: 8px; max-width: 130px; margin-top: 5px; }
		.pro-button { padding: 14px 18px; gap: 20px; }
		.product-nav-inner { gap: 12px; }
		.product-nav-links { flex: 1; justify-content: space-between; gap: 14px; }
		.product-nav-links a { font-size: 14px; }
		.nav-purchase { display: none; }
		.stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 0; }
		.stats > div { padding-inline: 20px 0; }
		.stats > div:nth-child(odd) { border-left: 0; padding-left: 0; }
		.stats dd { font-size: 56px; }
		.stats dd span { font-size: 21px; }
		.stats dt { margin-top: 7px; font-size: 10px; }
		.range-note { text-align: left; font-size: 8px; }
		.overview { grid-template-columns: 1fr; gap: 35px; }
		.overview-image :global(img) { aspect-ratio: 5 / 4; object-position: center 59%; }
		.overview h2 { font-size: 58px; }
		.overview-copy > p:not(.eyebrow) { font-size: 13px; }
