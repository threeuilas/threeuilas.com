---
import Layout from '../layouts/Layout.astro';
import ModelPreview from '../components/ModelPreview.astro';
import Disclosure from '../components/Disclosure.astro';
import QuestionList from '../components/QuestionList.astro';
import { availableProducts, products } from '../data/products';

const comparison = ['Motor', 'Battery Capacity', 'Battery System', 'Bed Size', 'Maximum Range', 'Top Speed'];
const originalProducts = products.slice(availableProducts.length);
type ModelPrice = { discountedPrice: number };
const originalPrice = (pricing: ModelPrice | { withDumpBed: ModelPrice; withoutDumpBed: ModelPrice }) =>
	'withDumpBed' in pricing
		? `$${pricing.withoutDumpBed.discountedPrice.toLocaleString('en-US')} standard / $${pricing.withDumpBed.discountedPrice.toLocaleString('en-US')} hydraulic bed`
		: `$${pricing.discountedPrice.toLocaleString('en-US')}`;
const questions = [
	{ question: 'How do I buy one?', answer: 'Contact us with the model you’re interested in. We’ll help schedule a test ride and arrange your purchase.' },
	{ question: 'Is delivery available?', answer: 'Yes. Delivery is available for an additional fee. Include your location when you contact us for a quote.' },
	{ question: 'How do I charge it?', answer: 'Each vehicle includes a wall charger that plugs into the vehicle.' },
	{ question: 'Where can I use it?', answer: 'Three Uilas are intended for private property, private roads, and off-road use. They are not sold as street-legal vehicles.' },
	{ question: 'How far can I drive?', answer: 'Maximum range is up to 120 miles for the Workhorse Pro and 35 miles for the Sparrow+. Load, hills, uneven surfaces, and driving conditions affect actual range.' },
	{ question: 'Can I order a custom vehicle?', answer: 'We can customize bed length, motor power, battery type, and more. Custom orders require a 50% deposit and can take up to six months. Contact us to discuss your needs.' },
	{ question: 'What can I carry?', answer: 'Tell us what you plan to haul so we can confirm the right model and load for your use. Original-model capacities, including the driver, are 500 lb for the Sparrow and 1,500–2,000 lb for the Workhorse.' },
];
---

<Layout title="Our Models | Electric Utility Tricycles | Three Uilas" description="Compare the Workhorse Pro and Sparrow+ electric utility tricycles. Explore pricing, lithium batteries, cargo beds, and local support in Hawaiʻi." ogImage="/workhorse-pro/cabin-front-wide-1920.webp">
	<div class="site-width">
		<section class="catalog-intro" aria-labelledby="catalog-title"><div><p class="ui-eyebrow">Our electric utility tricycles</p><h1 id="catalog-title" class="display-heading">FIND YOUR<br />EVERYDAY UILA.</h1></div><p class="body-copy">More room for hauling, or a smaller vehicle for daily trips. Choose the model that fits your work.<br /><span class="availability">Workhorse Pro and Sparrow+ are available now.</span></p></section>
		<section class="model-grid" aria-label="Available models">{availableProducts.map(product => <ModelPreview product={product} detailed />)}</section>
		<p class="catalog-note">*Maximum range varies with load, terrain, and driving conditions.</p>
	</div>

	<section class="comparison-section section-pad" aria-labelledby="comparison-title"><div class="site-width">
		<div class="section-top"><div><p class="ui-eyebrow">Side by side</p><h2 id="comparison-title" class="display-heading">COMPARE THE DETAILS.</h2></div></div>
		<div class="comparison-scroll" tabindex="0" role="region" aria-label="Model comparison table"><table><thead><tr><th scope="col">Specifications</th>{availableProducts.map(product => <th scope="col">{product.name.replace('Three Uilas ', '')}</th>)}</tr></thead><tbody>
			{comparison.map(label => <tr><th scope="row">{label === 'Maximum Range' ? 'Maximum range*' : label}</th>{availableProducts.map(product => <td>{product.specs.find(spec => spec.label === label)?.value}</td>)}</tr>)}
			<tr><th scope="row">Bed lift</th><td>Hydraulic, included</td><td>Standard bed</td></tr>
			<tr><th scope="row">Price</th>{availableProducts.map(product => <td>${product.pricing.discountedPrice.toLocaleString('en-US')}</td>)}</tr>
		</tbody></table></div>
		<div class="shared-features"><p>Included with both models</p><ul><li>All-steel construction</li><li>Wall charger</li><li>All-terrain tires</li><li>2-year parts warranty</li></ul></div>
		<p class="catalog-note">*Maximum range depends on load, terrain, and driving conditions.</p>
	</div></section>

	<section class="site-width section-pad questions-section" aria-labelledby="questions-title"><div><p class="ui-eyebrow">Buying & ownership</p><h2 id="questions-title" class="display-heading">COMMON<br />QUESTIONS.</h2></div><QuestionList questions={questions} /></section>

	<section class="site-width original-section" aria-label="Previous models">
		<Disclosure title="Original models" class="original-models">
			<span slot="title" class="archive-label">Original models <small>Sold out</small></span>
			<p class="body-copy original-intro">The original Workhorse and Sparrow are sold out. Specifications remain here for reference.</p>
			<div class="original-grid">
				{originalProducts.map(product => (
					<article>
						<img src={product.images[0]} alt={product.name} width="1024" height="768" loading="lazy" decoding="async" />
						<h3>{product.name.replace('Three Uilas ', '')}</h3>
						<p class="body-copy">{product.description}</p>
						<dl>{product.specs.map(spec => <div><dt>{spec.label}</dt><dd set:html={spec.value}></dd></div>)}</dl>
						<p class="original-price">{originalPrice(product.pricing)} <span>Sold out</span></p>
					</article>
				))}
			</div>
		</Disclosure>
	</section>

	<section class="inquiry-band" aria-labelledby="purchase-help"><div class="site-width"><div><h2 id="purchase-help">Need a hand choosing?</h2><p class="body-copy">Tell us what you plan to carry and where you’ll use it.</p></div><a href="/contact" class="action">Get in touch</a></div></section>
</Layout>

<style>
	.catalog-intro { display: grid; grid-template-columns: 1.2fr 1fr; gap: 70px; align-items: end; padding-block: 74px 55px; }
	h1 { font-size: clamp(60px, 6.4vw, 94px); }
	.catalog-intro > p { max-width: 390px; padding-bottom: 5px; }
	.availability { display: block; margin-top: 17px; color: #394330; font-size: 12px; }
	.model-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; }
	.catalog-note { font: 10px/1.8 system-ui, sans-serif; color: #66715c; margin-top: 26px; }
	.model-grid + .catalog-note { margin-bottom: 65px; }
	.comparison-section { background: #e8eae0; }
	.comparison-scroll { overflow-x: auto; }
	table { width: 100%; border-collapse: collapse; font: 13px/1.7 system-ui, sans-serif; text-align: left; }
	thead th { font-family: 'Asap Condensed', sans-serif; font-size: 30px; font-weight: 600; border-bottom: 2px solid #56634c; padding: 0 24px 22px; }
	thead th:first-child { font: 12px/1.7 system-ui, sans-serif; color: #5d6853; padding-left: 0; }
	tbody td, tbody th { padding: 18px 24px; border-bottom: 1px solid #c6cebb; }
	tbody th { width: 30%; font-weight: 400; color: #5d6853; padding-left: 0; }
	tbody td { width: 35%; }
	.shared-features { display: flex; gap: 38px; align-items: baseline; margin-top: 35px; }
	.shared-features > p { font-size: 22px; font-weight: 600; }
	.shared-features ul { display: flex; flex-wrap: wrap; gap: 12px 26px; list-style: none; font: 11px/1.8 system-ui, sans-serif; color: #556149; }
	.shared-features li::before { content: '✓'; color: #b80e00; margin-right: 8px; }
	.questions-section { display: grid; grid-template-columns: 1fr 1.5fr; gap: 72px; }
	summary::-webkit-details-marker { display: none; }
	.original-section :global(.original-models) { border-top: 1px solid var(--line); }
	.archive-label small { font: 11px/1.7 system-ui, sans-serif; color: var(--muted); margin-left: 20px; }
	.original-intro { margin-bottom: 28px; }
	.original-section { padding-bottom: 72px; }
	.original-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 44px; padding-bottom: 35px; }
	.original-grid img { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
	.original-grid h3 { margin: 22px 0 12px; font-size: 36px; font-weight: 600; }
	.original-grid dl { margin-block: 20px; }
	.original-grid dl > div { display: flex; justify-content: space-between; gap: 20px; padding: 12px 0; border-bottom: 1px solid #d4d8cb; font: 11px/1.8 system-ui, sans-serif; }
	.original-grid dt { color: #66715c; }
	.original-grid dd { max-width: 65%; text-align: right; }
	.original-price { font-size: 22px; font-weight: 500; }
	.original-price span { font: 10px/1.6 system-ui, sans-serif; color: #6e7665; margin-left: 10px; }
	.comparison-scroll:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
	@media (max-width: 1000px) { .catalog-intro { gap: 40px; } .model-grid { gap: 30px; } .shared-features { align-items: start; flex-direction: column; gap: 18px; } .questions-section { gap: 40px; } }
	@media (max-width: 700px) {
		.catalog-intro { grid-template-columns: 1fr; gap: 24px; padding-block: 45px 36px; }
		h1 { font-size: clamp(60px, 14vw, 78px); }
		.model-grid { grid-template-columns: 1fr; gap: 45px; }
		.model-grid + .catalog-note { margin-bottom: 45px; }
		table { table-layout: fixed; font-size: 11px; }
		thead th { width: 35%; font-size: clamp(20px, 5.6vw, 25px); padding-inline: 8px; }
		thead th:first-child { width: 30%; font-size: 10px; }
		tbody td, tbody th { padding: 15px 8px; overflow-wrap: anywhere; }
		tbody th { font-size: 10px; }
		tbody th { padding-left: 0; }
		.questions-section { grid-template-columns: 1fr; gap: 28px; }
		.original-grid { grid-template-columns: 1fr; gap: 35px; }
		.original-section { padding-bottom: 48px; }
	}
</style>
