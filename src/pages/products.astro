---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
import Button from '../components/Button.astro';
---

<Layout title="Products - Three Uilas" description="Workhorse Pro and Sparrow+ electric tricycles are available for purchase in Hawaiʻi. Compare specifications and pricing, then contact Three Uilas to buy.">
	<section class="py-12 bg-[#FDFDFC]">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h1 class="text-4xl font-bold mb-4 text-gray-800">Our Products</h1>
				<p class="text-lg text-gray-600 mb-3">The Workhorse Pro and Sparrow+ are available for purchase now. Choose your model below and contact us to arrange your purchase.</p>
				<p class="text-lg text-gray-600 mb-8">Delivery is available for an additional fee. <a href="/contact" class="text-link">Contact us</a> for a delivery quote.</p>

				<!-- Product Grid -->
				<div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
					{products.map((product) => (
						<ProductCard
							name={product.name}
							description={product.description}
							images={product.images}
							specs={product.specs}
							alt={product.name}
							pricing={product.pricing}
							dark={'dark' in product ? product.dark : false}
						/>
					))}
				</div>

				<!-- Shared Features -->
				<div class="bg-white border border-gray-200 rounded-lg p-8 mb-12">
					<h3 class="text-2xl font-semibold mb-6 text-gray-800">Standard Features (All Models)</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">All-steel construction</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">2-year parts warranty</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">All-terrain tires</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">Highly repairable</span>
						</div>
					</div>
				</div>

				<!-- FAQ Section -->
				<div class="bg-white border border-gray-200 rounded-lg p-8 mb-12">
					<h2 class="text-3xl font-bold mb-8 text-gray-800">Frequently Asked Questions</h2>
					<div class="space-y-6">
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Are they electric?</h3>
							<p class="text-lg text-gray-700">A: Yes, Three Uilas are fully electric.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: How do I charge a Three Uila?</h3>
							<p class="text-lg text-gray-700">A: Each Three Uila comes with a wall charger that plugs right into the vehicle.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Are Three Uilas street legal?</h3>
							<p class="text-lg text-gray-700">A: No they are not. While there may be exceptions in some cases, they are intended to be driven on private property, private roads, or off-road.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the maximum speed?</h3>
							<p class="text-lg text-gray-700">A: Three Uilas are limited to 25mph.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the maximum range?</h3>
							<p class="text-lg text-gray-700">A: Range highly depends on usage. Usage on flat paved surfaces will greatly extend range over hilly bumpy surfaces.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the carrying capacity?</h3>
							<p class="text-lg text-gray-700">A: The Sparrow has a carrying capacity of 500lb, including driver. The Workhorse has a carrying capacity of 1500-2000lb, including driver.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Can I customize my Three Uila?</h3>
							<p class="text-lg text-gray-700">A: We can customize the length, motor power, battery type, and more! Custom orders require a 50% deposit and can take up to six months.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: How can I buy one?</h3>
							<p class="text-lg text-gray-700">A: The Workhorse Pro and Sparrow+ are available for purchase now. <a href="/contact" class="text-link">Contact us</a> with the model you’re interested in to arrange your purchase.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Is delivery available?</h3>
							<p class="text-lg text-gray-700">A: Yes, delivery is available for an additional fee. <a href="/contact" class="text-link">Contact us</a> for a delivery quote.</p>
						</div>
					</div>
				</div>

				<div class="bg-gray-100 rounded-lg p-8 text-center">
					<h3 class="text-xl font-semibold mb-3 text-gray-800">Interested in our products?</h3>
					<p class="text-lg text-gray-600 mb-6">Ready to purchase a Workhorse Pro or Sparrow+? Contact us to get started or ask a question about either model.</p>
					<Button href="/contact" class="w-full sm:w-auto">Contact us</Button>
				</div>
			</div>
		</div>
	</section>
</Layout>
