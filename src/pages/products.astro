---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';

const products = [
	{
		name: 'Three Uilas Mini',
		description: 'Compact and versatile three uila perfect for zipping around the neighborhood with room for a passenger and a small amount of cargo.',
		images: '/small-three-uila.jpg',
		specs: [
			{ label: 'Bed Size', value: '3ft 6in' },
			{ label: 'Motor', value: '500W' },
			{ label: 'Battery System', value: '48V AGM Deep Cycle' },
			{ label: 'Maximum Range', value: '35 miles' },
			{ label: 'Top Speed', value: '25 mph' },
			{ label: 'Special Features', value: 'Foldable Rear Seat' },
		],
		pricing: {
			originalPrice: 3000,
			discountedPrice: 2750,
			discountAmount: 250,
		},
	},
	{
		name: 'Three Uilas Heavylifter',
		description: 'Heavy-duty three uila built for hauling and farm work. Optional hydraulic auto-dump bed makes hauling material a breeze.',
		images: ['/large-red-three-uila-front.jpg', '/large-three-uila-back.jpg'],
		specs: [
			{ label: 'Bed Size', value: '5ft' },
			{ label: 'Motor', value: '1200W' },
			{ label: 'Battery System', value: '72V AGM Deep Cycle' },
			{ label: 'Maximum Range', value: '60 miles' },
			{ label: 'Top Speed', value: '25 mph' },
			{ label: 'Special Features', value: 'Optional Hydraulic Auto-Dump Bed<br />Partially Enclosed Wind/Rain Screen' },
		],
		pricing: {
			withDumpBed: {
				originalPrice: 5500,
				discountedPrice: 5000,
				discountAmount: 500,
			},
			withoutDumpBed: {
				originalPrice: 4500,
				discountedPrice: 4250,
				discountAmount: 250,
			},
		},
	},
];
---

<Layout title="Products - Three Uilas">
	<section class="py-12 bg-[#FDFDFC]">
		<div class="container mx-auto px-4">
			<div class="max-w-6xl mx-auto">
				<h1 class="text-4xl font-bold mb-4 text-gray-800">Our Products</h1>

				<!-- Product Grid -->
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
					{products.map((product) => (
						<ProductCard
							name={product.name}
							description={product.description}
							images={product.images}
							specs={product.specs}
							alt={product.name}
							pricing={product.pricing}
						/>
					))}
				</div>

				<!-- Shared Features -->
				<div class="bg-white border border-gray-200 rounded-lg p-8 mb-12">
					<h3 class="text-2xl font-semibold mb-6 text-gray-800">Standard Features (All Models)</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">All-steel construction</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">2-year parts warranty</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">All-terrain tires</span>
						</div>
						<div class="flex items-start">
							<span class="text-[#DB1100] mr-3">✓</span>
							<span class="text-lg text-gray-700">Highly repairable</span>
						</div>
					</div>
				</div>

				<!-- FAQ Section -->
				<div class="bg-white border border-gray-200 rounded-lg p-8 mb-12">
					<h2 class="text-3xl font-bold mb-8 text-gray-800">Frequently Asked Questions</h2>
					<div class="space-y-6">
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Are they electric?</h3>
							<p class="text-lg text-gray-700">A: Yes, Three Uilas are fully electric.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: How do I charge a Three Uila?</h3>
							<p class="text-lg text-gray-700">A: Each Three Uila comes with a wall charger that plugs right into the vehicle.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Are Three Uilas street legal?</h3>
							<p class="text-lg text-gray-700">A: No they are not. While there may be exceptions in some cases, they are intended to be driven on private property, private roads, or off-road.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the maximum speed?</h3>
							<p class="text-lg text-gray-700">A: Three Uilas are limited to 25mph.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the maximum range?</h3>
							<p class="text-lg text-gray-700">A: Range highly depends on usage. Usage on flat paved surfaces will greatly extend range over hilly bumpy surfaces.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: What is the carrying capacity?</h3>
							<p class="text-lg text-gray-700">A: The Sparrow has a carrying capacity of 500lb, including driver. The Heavylifter has a carrying capacity of 1500-2000lb, including driver.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: Can I customize my Three Uila?</h3>
							<p class="text-lg text-gray-700">A: We can customize the length, motor power, battery type, and more! Customization requires a pre-order with a 50% deposit and up to 6-month lead time.</p>
						</div>
						<div>
							<h3 class="text-xl font-semibold mb-2 text-gray-800">Q: How can I buy one?</h3>
							<p class="text-lg text-gray-700">A: Contact us now!</p>
						</div>
					</div>
				</div>

				<div class="bg-gray-100 rounded-lg p-8 text-center">
					<h3 class="text-xl font-semibold mb-3 text-gray-800">Interested in our products?</h3>
					<p class="text-lg text-gray-600 mb-6">Get in touch to learn more about specifications, pricing, and availability.</p>
					<a href="/contact" class="bg-[#DB1100] text-[#FDFDFC] px-8 py-3 rounded font-medium hover:bg-[#DB1100]/90 transition-colors inline-block">
						Contact Us
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

