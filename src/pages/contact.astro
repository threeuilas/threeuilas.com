---
import Layout from '../layouts/Layout.astro';

const vehicles = [
	'Three Uilas Workhorse Pro',
	'Three Uilas Sparrow+',
	'Three Uilas Workhorse',
	'Three Uilas Sparrow',
	'Other',
];
---

<Layout title="Get in Touch | Three Uilas" description="Contact Three Uilas in Hilo, Hawaiʻi about electric utility tricycles, parts, and delivery. Call or text (808) 300-0605, or send us a message.">
	<div class="site-width contact-page">
		<section class="contact-intro" aria-labelledby="contact-title"><div><p class="ui-eyebrow">Contact Three Uilas</p><h1 id="contact-title" class="display-heading">LET’S TALK.</h1></div><p class="body-copy">Choosing a model, looking for parts, or asking about your vehicle? Send us a message or get in touch directly.</p></section>
		<div class="contact-layout">
			<aside class="contact-details" aria-labelledby="direct-contact-title">
				<p class="ui-eyebrow">Hilo, Hawaiʻi</p>
				<h2 id="direct-contact-title">A LOCAL TEAM.<br />HERE TO HELP.</h2>
				<div class="contact-method"><h3>Call or text</h3><a href="tel:+18083000605" class="phone-number">(808) 300-0605</a><div class="phone-actions"><a href="tel:+18083000605" class="inline-link">Call us</a><a href="sms:+18083000605" class="inline-link">Text us</a></div></div>
				<div class="contact-method"><h3>Email</h3><a href="mailto:info@threeuilas.com" class="email-link">info@threeuilas.com</a></div>
				<div class="contact-method delivery"><h3>Delivery available</h3><p>Include your location in your message for a delivery quote.</p></div>
			</aside>
			<div class="form-panel">
				<form id="contact-form" novalidate aria-labelledby="form-title">
					<h2 id="form-title">Send a message.</h2>
					<p class="form-note">Fields marked <span aria-hidden="true">*</span> are required.</p>
					<input type="hidden" id="submission-id" name="submissionId" />
					<div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
						<label for="website">Website</label><input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
					</div>
					<div class="form-fields">
						<div class="field"><label for="name">Name <span>*</span></label><input type="text" id="name" name="name" required maxlength="200" autocomplete="name" /></div>
						<div class="field"><label for="contact">Email or phone <span>*</span></label><input type="text" id="contact" name="contact" required maxlength="254" autocomplete="email" /></div>
						<div class="field field-wide"><label for="vehicle">Interested in</label><select id="vehicle" name="vehicle"><option value="">Select a vehicle (optional)</option>{vehicles.map(vehicle => <option value={vehicle}>{vehicle}</option>)}</select></div>
						<div class="field field-wide"><label for="message">Message <span>*</span></label><textarea id="message" name="message" rows={6} required maxlength="2000"></textarea></div>
					</div>
					<div class="cf-turnstile" data-sitekey="0x4AAAAAADJG-0gHq2xwyrGB" data-theme="light" data-size="compact"></div>
					<p id="form-error" class="hidden" role="alert"></p>
					<button type="submit" id="submit-btn" class="action">Send message</button>
				</form>
				<div id="form-success" class="hidden" role="status"><h2>Message sent.</h2><p class="body-copy">We’ll get back to you as soon as possible.</p></div>
			</div>
		</div>
	</div>
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async is:inline></script>
<script>
	const vehicleParam = new URLSearchParams(window.location.search).get('vehicle');
	const select = document.getElementById('vehicle');
	if (vehicleParam && select instanceof HTMLSelectElement) {
		const match = Array.from(select.options).find(o => o.value === vehicleParam);
		if (match) match.selected = true;
	}

	const form = document.getElementById('contact-form') as HTMLFormElement;
	const submissionId = document.getElementById('submission-id') as HTMLInputElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const errorEl = document.getElementById('form-error') as HTMLParagraphElement;
	const successEl = document.getElementById('form-success') as HTMLDivElement;
	submissionId.value = crypto.randomUUID();

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		submitBtn.disabled = true;
		submitBtn.setAttribute('aria-busy', 'true');
		submitBtn.textContent = 'Sending...';
		errorEl.classList.add('hidden');

		try {
			const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
			const data = await res.json() as { error?: string };

			if (res.ok) {
				form.classList.add('hidden');
				successEl.classList.remove('hidden');
			} else {
				errorEl.textContent = data.error ?? 'Something went wrong. Please try again.';
				errorEl.classList.remove('hidden');
				submitBtn.disabled = false;
				submitBtn.textContent = 'Send message';
			}
		} catch {
			errorEl.textContent = 'Something went wrong. Please try again.';
			errorEl.classList.remove('hidden');
			submitBtn.disabled = false;
			submitBtn.textContent = 'Send message';
		} finally {
			submitBtn.removeAttribute('aria-busy');
		}
	});
</script>

<style>
	.contact-page { padding-bottom: 85px; }
	.contact-intro { display: grid; grid-template-columns: 1fr 1fr; align-items: end; gap: 70px; padding-block: 65px 50px; }
	h1 { font-size: clamp(70px, 7vw, 100px); }
	.contact-intro > p { max-width: 430px; padding-bottom: 3px; }
	.contact-layout { display: grid; grid-template-columns: .8fr 1.2fr; align-items: stretch; }
	.contact-details { background: #283325; color: #f5f4ef; padding: 42px clamp(28px, 3.8vw, 56px); }
	.contact-details .ui-eyebrow { color: #c3ceb9; font-size: 9px; }
	.contact-details h2 { font-size: clamp(36px, 3.4vw, 48px); font-weight: 700; line-height: 1.05; margin-bottom: 34px; }
	.contact-method { padding-block: 23px; border-top: 1px solid #56634b; }
	.contact-method h3 { font: 500 11px/1.6 system-ui, sans-serif; color: #c3ceb9; margin-bottom: 12px; }
	.phone-number { font-size: clamp(27px, 2.7vw, 38px); font-weight: 600; }
	.phone-actions { display: flex; gap: 26px; margin-top: 12px; }
	.phone-actions a { font-size: 17px; }
	.contact-details a:hover { color: #d5e0c9; }
	.email-link { font-size: 25px; overflow-wrap: anywhere; }
	.contact-method.delivery h3 { font-family: 'Asap Condensed', sans-serif; font-size: 26px; font-weight: 600; color: #f5f4ef; }
	.delivery p { font: 12px/1.8 system-ui, sans-serif; color: #c3ceb9; max-width: 250px; }
	.form-panel { background: #e8eae0; padding: 42px clamp(24px, 3.8vw, 56px); }
	.form-panel h2 { font-size: 35px; font-weight: 600; line-height: 1.15; }
	.form-note { font: 10px/1.8 system-ui, sans-serif; color: #66715b; margin: 12px 0 30px; }
	.form-fields { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 25px 20px; }
	.field-wide { grid-column: 1 / -1; }
	.field label { display: block; margin-bottom: 9px; font: 500 12px/1.5 system-ui, sans-serif; }
	.field label > span { color: #b80e00; }
	.field input, .field select, .field textarea { display: block; width: 100%; min-width: 0; border: 1px solid #aeb7a3; border-radius: 0; padding: 12px; background: #f5f4ef; color: #252a22; font: 14px/1.6 system-ui, sans-serif; }
	.field textarea { resize: vertical; min-height: 160px; }
	.field input:focus-visible, .field select:focus-visible, .field textarea:focus-visible { outline: 2px solid #596b49; outline-offset: 2px; }
	.cf-turnstile { margin-top: 25px; width: 100%; min-width: 0; }
	#submit-btn { margin-top: 24px; width: 100%; cursor: pointer; }
	#form-error { font: 12px/1.7 system-ui, sans-serif; color: #a50e00; margin-top: 18px; }
	#form-success { padding-block: 35px; }
	#form-success p { margin-top: 18px; }
	.contact-details a:focus-visible { outline: 2px solid white; outline-offset: 5px; }
	@media (max-width: 1000px) { .contact-intro { gap: 40px; } .contact-layout { grid-template-columns: .85fr 1.15fr; } .contact-details, .form-panel { padding-inline: 28px; } .form-fields { grid-template-columns: minmax(0, 1fr); } }
	@media (max-width: 700px) { .contact-page { padding-bottom: 48px; } .contact-intro { grid-template-columns: 1fr; gap: 22px; padding-block: 44px 35px; } h1 { font-size: clamp(66px, 14vw, 90px); } .contact-layout { grid-template-columns: minmax(0, 1fr); } .contact-details { padding: 32px 24px 16px; } .form-panel { padding: 32px 24px; } .contact-details h2 { font-size: 42px; } .email-link { font-size: 24px; } }
	@media (max-width: 360px) { .form-panel, .contact-details { padding-inline: 18px; } }
</style>
