---
import Layout from '../layouts/Layout.astro';

const vehicles = [
	'Three Uilas Workhorse Pro',
	'Three Uilas Workhorse',
	'Three Uilas Sparrow+',
	'Three Uilas Sparrow',
	'Other',
];
---

<Layout title="Contact - Three Uilas">
	<section class="py-12 bg-[#FDFDFC]">
		<div class="container mx-auto px-4">
			<div class="max-w-2xl mx-auto">
				<h1 class="text-4xl font-bold mb-4 text-gray-800">Contact Us</h1>
				<p class="text-lg text-gray-600 mb-8">Have questions about our electric tricycles? Want to preorder? We're here to help.</p>

				<div class="bg-white border border-gray-200 rounded-lg p-8 mb-6">
					<form id="contact-form" class="space-y-5" novalidate>
						<!-- honeypot: hidden from real users, bots fill it in -->
						<div style="position:absolute;left:-9999px;top:-9999px;" aria-hidden="true">
							<label for="website">Website</label>
							<input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
						</div>
						<div>
							<label for="name" class="block text-sm font-medium text-gray-700 mb-1">Name <span class="text-[#DB1100]">*</span></label>
							<input type="text" id="name" name="name" required autocomplete="name"
								class="w-full border border-gray-300 rounded px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-[#DB1100] focus:border-transparent" />
						</div>
						<div>
							<label for="contact" class="block text-sm font-medium text-gray-700 mb-1">Email or Phone <span class="text-[#DB1100]">*</span></label>
							<input type="text" id="contact" name="contact" required autocomplete="email"
								class="w-full border border-gray-300 rounded px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-[#DB1100] focus:border-transparent" />
						</div>
						<div>
							<label for="vehicle" class="block text-sm font-medium text-gray-700 mb-1">Interested in</label>
							<select id="vehicle" name="vehicle"
								class="w-full border border-gray-300 rounded px-3 py-2 text-base text-gray-800 focus:outline-none focus:ring-2 focus:ring-[#DB1100] focus:border-transparent">
								<option value="">Select a vehicle (optional)</option>
								{vehicles.map(v => (
									<option value={v}>{v}</option>
								))}
							</select>
						</div>
						<div>
							<label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message <span class="text-[#DB1100]">*</span></label>
							<textarea id="message" name="message" rows={4} required
								class="w-full border border-gray-300 rounded px-3 py-2 text-base focus:outline-none focus:ring-2 focus:ring-[#DB1100] focus:border-transparent resize-none"></textarea>
						</div>
						<div class="cf-turnstile" data-sitekey="0x4AAAAAADJG-0gHq2xwyrGB" data-theme="light"></div>
						<p id="form-error" class="hidden text-sm text-red-600"></p>
						<button type="submit" id="submit-btn"
							class="w-full bg-[#DB1100] hover:bg-[#DB1100]/90 text-white px-6 py-3 rounded font-medium transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
							Send Message
						</button>
					</form>
					<div id="form-success" class="hidden text-center py-4">
						<p class="text-xl font-semibold text-gray-800 mb-2">Message sent!</p>
						<p class="text-gray-600">We'll get back to you as soon as possible.</p>
					</div>
				</div>

				<div class="bg-white border border-gray-200 rounded-lg p-8">
					<div class="space-y-6">
						<div>
							<p class="text-base font-medium text-gray-800 mb-2">Email</p>
							<a href="mailto:info@threeuilas.com" class="text-lg text-[#DB1100] hover:underline">info@threeuilas.com</a>
						</div>
						<div>
							<p class="text-base font-medium text-gray-800 mb-2">Phone (Call or Text)</p>
							<a href="tel:+18088958882" class="text-lg text-[#DB1100] hover:underline">(808) 895-8882</a>
							<a href="sms:+18088958882" class="block text-sm text-gray-500 hover:text-[#DB1100] transition-colors mt-1">Text us →</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
</Layout>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async is:inline></script>
<script>
	const vehicleParam = new URLSearchParams(window.location.search).get('vehicle');
	if (vehicleParam) {
		const select = document.getElementById('vehicle') as HTMLSelectElement;
		const match = Array.from(select.options).find(o => o.value === vehicleParam);
		if (match) match.selected = true;
	}

	const form = document.getElementById('contact-form') as HTMLFormElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	const errorEl = document.getElementById('form-error') as HTMLParagraphElement;
	const successEl = document.getElementById('form-success') as HTMLDivElement;

	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		submitBtn.disabled = true;
		submitBtn.textContent = 'Sending...';
		errorEl.classList.add('hidden');

		try {
			const res = await fetch('/api/contact', { method: 'POST', body: new FormData(form) });
			const data = await res.json() as { error?: string };

			if (res.ok) {
				form.classList.add('hidden');
				successEl.classList.remove('hidden');
			} else {
				errorEl.textContent = data.error ?? 'Something went wrong. Please try again.';
				errorEl.classList.remove('hidden');
				submitBtn.disabled = false;
				submitBtn.textContent = 'Send Message';
			}
		} catch {
			errorEl.textContent = 'Something went wrong. Please try again.';
			errorEl.classList.remove('hidden');
			submitBtn.disabled = false;
			submitBtn.textContent = 'Send Message';
		}
	});
</script>
