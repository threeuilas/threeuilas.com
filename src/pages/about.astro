---
import Layout from '../layouts/Layout.astro';
import WorkhorsePhoto from '../components/WorkhorsePhoto.astro';
---

<Layout title="Our Story | Three Uilas" description="Locally owned and operated in Hilo, Hawaiʻi. Our mission is to transform Hawaiʻi agriculture with affordable, useful farm vehicles." ogImage="/workhorse-pro/cabin-front-wide-1920.webp">
	<section class="story-hero site-width" aria-labelledby="story-title">
		<div class="story-intro">
			<p class="ui-eyebrow">Our story</p>
			<h1 id="story-title" class="display-heading">LOCAL ROOTS.<br /><span>PRACTICAL<br />VEHICLES.</span></h1>
			<p class="body-copy">Three Uilas is locally owned and operated in Hilo, Hawaiʻi. We offer electric utility tricycles for daily trips, hauling, and work around your property.</p>
			<p class="body-copy">Our mission is to transform Hawaiʻi agriculture with affordable, useful farm vehicles.</p>
		</div>
		<WorkhorsePhoto name="cabin-front-wide" sizes="(max-width: 700px) 100vw, 50vw" priority />
	</section>

	<section class="inquiry-band" aria-labelledby="story-models"><div class="site-width"><div><h2 id="story-models">Find the right uila for your day.</h2><p class="body-copy">Explore the Workhorse Pro and Sparrow+.</p></div><a href="/products" class="action">Explore our models</a></div></section>
</Layout>

<style>
	.story-hero { display: grid; grid-template-columns: 1fr 1.05fr; align-items: center; gap: 70px; padding-block: 65px 80px; }
	h1 { font-size: clamp(54px, 5.2vw, 80px); }
	h1 span { color: #748167; }
	.story-intro .body-copy { max-width: 450px; margin-top: 26px; }
	.story-hero > :global(img) { width: 100%; height: 570px; object-fit: cover; object-position: 59% center; }
	@media (max-width: 1050px) { .story-hero { gap: 40px; } .story-hero > :global(img) { height: 530px; } }
	@media (max-width: 700px) { .story-hero { grid-template-columns: 1fr; gap: 32px; padding-block: 44px 48px; } h1 { font-size: clamp(50px, 12vw, 72px); } .story-hero > :global(img) { height: 340px; } }
</style>
