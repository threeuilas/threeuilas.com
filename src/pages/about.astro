---
import Layout from '../layouts/Layout.astro';
---

<Layout title="About - Three Uilas">
	<section class="py-12 bg-[#FDFDFC]">
		<div class="container mx-auto px-4">
			<div class="max-w-3xl mx-auto">
				<h1 class="text-4xl font-bold mb-8 text-gray-800">About Three Uilas</h1>
				
				<div class="prose prose-lg max-w-none">
					<p class="text-xl text-gray-700 mb-6">
						Three Uilas is dedicated to providing quality electric tricycles for all. Based in Orchidland Estates, we believe in practical, reliable transportation solutions that serve the community.
					</p>
					
					<h2 class="text-2xl font-semibold mt-8 mb-4 text-gray-800">Our Mission</h2>
					<p class="text-lg text-gray-600 mb-6">
						Quality electric tricycles for all.
					</p>

					<h2 class="text-2xl font-semibold mt-8 mb-4 text-gray-800">Why Choose Us</h2>
					<ul class="list-none space-y-3 text-lg text-gray-600">
						<li class="flex items-start">
							<span class="text-[#DB1100] mr-3">•</span>
							<span>Locally owned and operated</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#DB1100] mr-3">•</span>
							<span>Fair treatment of our workers</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#DB1100] mr-3">•</span>
							<span>Competitive pricing without compromising on quality</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#DB1100] mr-3">•</span>
							<span>User-serviceable, easy to repair, and highly moddable with all steel construction</span>
						</li>
						<li class="flex items-start">
							<span class="text-[#DB1100] mr-3">•</span>
							<span>Comprehensive 2-year parts warranty and local support</span>
						</li>
					</ul>
				</div>

				<div class="mt-12 text-center">
					<a href="/contact" class="bg-[#DB1100] text-[#FDFDFC] px-8 py-3 rounded font-medium hover:bg-[#DB1100]/90 transition-colors inline-block">
						Get in Touch
					</a>
				</div>
			</div>
		</div>
	</section>
</Layout>

