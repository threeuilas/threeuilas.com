---
interface Props {
	enabled: boolean;
	href: string;
	width: number;
	height: number;
	alt: string;
}

const { enabled, href, width, height, alt } = Astro.props;
---

{enabled ? (
	<a class="product-photo-link" href={href} data-product-photo data-pswp-width={width} data-pswp-height={height} target="_blank" rel="noopener" aria-label={`Enlarge photo: ${alt}`}>
		<slot />
		<span class="photo-expand" aria-hidden="true">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 4H4v5m11-5h5v5M4 15v5h5m11-5v5h-5" /></svg>
		</span>
	</a>
) : <slot />}

<style>
	.product-photo-link { position: relative; display: block; min-width: 0; cursor: zoom-in; }
	.product-photo-link :global(img) { display: block; }
	.photo-expand { position: absolute; right: 14px; bottom: 14px; display: grid; place-items: center; width: 36px; height: 36px; color: white; background: rgb(20 29 18 / 80%); border: 1px solid rgb(255 255 255 / 60%); pointer-events: none; }
	.photo-expand svg { width: 22px; height: 22px; }
	.product-photo-link:hover .photo-expand { background: #252f24; }
	.product-photo-link:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
</style>
