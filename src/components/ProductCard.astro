---
import ProductCarousel from './ProductCarousel.astro';

interface Spec {
	label: string;
	value: string;
}

interface Pricing {
	originalPrice: number;
	discountedPrice: number;
	discountAmount: number;
	soldOut?: boolean;
	remaining?: number;
}

interface DualPricing {
	withDumpBed: Pricing;
	withoutDumpBed: Pricing;
}

interface Props {
	name: string;
	description: string;
	specs: Spec[];
	images: string | string[];
	alt?: string;
	learnMoreLink?: string;
	pricing?: Pricing | DualPricing;
	comingSoon?: boolean;
	preorder?: boolean;
	dark?: boolean;
}

const {
	name,
	description,
	specs,
	images,
	alt = name,
	learnMoreLink,
	pricing,
	comingSoon = false,
	preorder = false,
	dark = false
} = Astro.props;

const isMultipleImages = Array.isArray(images);
const hasDualPricing = pricing && 'withDumpBed' in pricing;

const stockRemaining = hasDualPricing
	? (pricing.withDumpBed.remaining ?? pricing.withoutDumpBed.remaining)
	: pricing && !hasDualPricing
		? pricing.remaining
		: undefined;

const isAllSoldOut = hasDualPricing
	? (pricing.withDumpBed.soldOut && pricing.withoutDumpBed.soldOut)
	: pricing && !hasDualPricing
		? pricing.soldOut === true
		: false;

const defaultCtaHref = `/contact?vehicle=${encodeURIComponent(name)}`;
const ctaHref = learnMoreLink ?? defaultCtaHref;
const ctaLabel = comingSoon ? 'Stay Updated' : preorder ? 'Preorder Now' : isAllSoldOut ? 'Join Waitlist' : 'Inquire to Buy';

const cardClass = dark
	? 'bg-gray-900 border border-gray-700 rounded-lg overflow-hidden hover:shadow-lg transition-shadow flex flex-col'
	: 'bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow flex flex-col';
const placeholderClass = dark
	? 'w-full aspect-[4/3] bg-gray-800 flex items-center justify-center border-b border-gray-700'
	: 'w-full aspect-[4/3] bg-[#FDFDFC] flex items-center justify-center border-b border-gray-200';
const titleClass = dark ? 'text-2xl font-semibold text-white' : 'text-2xl font-semibold text-gray-800';
const descClass = dark ? 'text-base md:text-lg text-gray-300 mb-6' : 'text-base md:text-lg text-gray-600 mb-6';
const savingsLabelClass = dark ? 'text-base font-semibold text-blue-400 uppercase tracking-wide' : 'text-base font-semibold text-[#DB1100] uppercase tracking-wide';
const priceDividerClass = dark ? 'mb-6 pb-6 border-b border-gray-700' : 'mb-6 pb-6 border-b border-gray-200';
const origPriceClass = dark ? 'text-lg text-gray-500 line-through' : 'text-lg text-gray-400 line-through';
const savingsClass = dark ? 'text-base font-medium text-blue-400' : 'text-base font-medium text-[#DB1100]';
const specLabelClass = dark ? 'text-gray-400' : 'text-gray-600';
const specValueClass = dark ? 'font-medium text-white text-right' : 'font-medium text-gray-800 text-right';
const ctaClass = dark
	? 'bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded font-medium transition-colors inline-flex items-center justify-center mt-auto text-sm'
	: 'bg-[#DB1100] hover:bg-[#DB1100]/90 text-[#FDFDFC] px-6 py-2.5 rounded font-medium transition-colors inline-flex items-center justify-center mt-auto text-sm';
---

<div class={cardClass}>
	{comingSoon ? (
		<div class={placeholderClass}>
			<div class="text-center px-6">
				<p class="text-3xl font-bold text-[#DB1100] mb-2">Coming Soon!</p>
				<p class="text-lg text-gray-600">Stay tuned for updates</p>
			</div>
		</div>
	) : preorder ? (
		<div class={placeholderClass}>
			<div class="text-center px-6">
				<p class={`text-3xl font-bold mb-1 ${dark ? 'text-white' : 'text-[#DB1100]'}`}>Preorder Now</p>
				{pricing && !('withDumpBed' in pricing) && pricing.discountAmount > 0 && (
					<p class={`text-3xl font-bold mb-2 ${dark ? 'text-white' : 'text-[#DB1100]'}`}>Save ${pricing.discountAmount.toLocaleString()}</p>
				)}
				<p class={dark ? 'text-lg text-gray-400' : 'text-lg text-gray-600'}><a href={ctaHref} class={dark ? 'underline hover:text-blue-400 transition-colors' : 'underline hover:text-[#DB1100] transition-colors'}>Contact us</a> to preorder yours today</p>
			</div>
		</div>
	) : isMultipleImages ? (
		<ProductCarousel
			images={images}
			alt={alt}
		/>
	) : (
		<img
			src={images}
			alt={alt}
			class="w-full aspect-[4/3] object-cover"
			loading="lazy"
			decoding="async"
		/>
	)}
	<div class="p-6 flex flex-col flex-1">
		<div class="flex items-center gap-3 mb-3">
			<h3 class={titleClass}>{name}</h3>
			{comingSoon ? (
				<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Coming Soon</span>
			) : preorder ? (
				<span class={dark ? 'bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide' : 'bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide'}>Preorder</span>
			) : (
				<span class={isAllSoldOut ? 'bg-red-100 text-red-700 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide' : stockRemaining !== undefined ? 'bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide' : 'bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide'}>
					{isAllSoldOut ? 'Sold Out' : stockRemaining !== undefined ? `${stockRemaining} remaining` : 'In Stock'}
				</span>
			)}
		</div>
		<p class={descClass}>{description}</p>

		{pricing && (
			<div class={priceDividerClass}>
				{!hasDualPricing && pricing.discountAmount > 0 && (
					<div class="mb-2">
						<span class={savingsLabelClass}>{preorder ? `Save $${pricing.discountAmount.toLocaleString()} with 50% preorder deposit` : 'Early Bird Discount'}</span>
					</div>
				)}
				{hasDualPricing && (pricing.withDumpBed.discountAmount > 0 || pricing.withoutDumpBed.discountAmount > 0) && (
					<div class="mb-2">
						<span class={savingsLabelClass}>Early Bird Discount</span>
					</div>
				)}
				{hasDualPricing ? (
					<div class="space-y-4">
						<div>
							<div class="flex items-baseline gap-2 mb-1">
								<span class={specLabelClass + ' text-base'}>With Hydraulic Auto-dump Bed:</span>
								{pricing.withDumpBed.soldOut && (
									<span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">Sold Out</span>
								)}
								{pricing.withDumpBed.remaining !== undefined && (
									<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">{pricing.withDumpBed.remaining} remaining</span>
								)}
							</div>
							<div class="flex items-baseline gap-2">
								<span class={`text-2xl font-bold ${pricing.withDumpBed.soldOut ? 'text-gray-400 line-through' : dark ? 'text-white' : 'text-gray-800'}`}>${pricing.withDumpBed.discountedPrice.toLocaleString()}</span>
								{pricing.withDumpBed.discountAmount > 0 && <span class={origPriceClass}>${pricing.withDumpBed.originalPrice.toLocaleString()}</span>}
								{!pricing.withDumpBed.soldOut && pricing.withDumpBed.discountAmount > 0 && (
									<span class={savingsClass}>Save ${pricing.withDumpBed.discountAmount}</span>
								)}
							</div>
						</div>
						<div>
							<div class="flex items-baseline gap-2 mb-1">
								<span class={specLabelClass + ' text-base'}>With Standard Bed:</span>
								{pricing.withoutDumpBed.soldOut && (
									<span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">Sold Out</span>
								)}
								{pricing.withoutDumpBed.remaining !== undefined && (
									<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">{pricing.withoutDumpBed.remaining} remaining</span>
								)}
							</div>
							<div class="flex items-baseline gap-2">
								<span class={`text-2xl font-bold ${pricing.withoutDumpBed.soldOut ? 'text-gray-400 line-through' : dark ? 'text-white' : 'text-gray-800'}`}>${pricing.withoutDumpBed.discountedPrice.toLocaleString()}</span>
								{pricing.withoutDumpBed.discountAmount > 0 && <span class={origPriceClass}>${pricing.withoutDumpBed.originalPrice.toLocaleString()}</span>}
								{!pricing.withoutDumpBed.soldOut && pricing.withoutDumpBed.discountAmount > 0 && (
									<span class={savingsClass}>Save ${pricing.withoutDumpBed.discountAmount.toLocaleString()}</span>
								)}
							</div>
						</div>
					</div>
				) : pricing.discountAmount > 0 ? (
					<>
						{pricing.remaining !== undefined && (
							<div class="mb-1">
								<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">{pricing.remaining} remaining</span>
							</div>
						)}
						<div class="flex items-baseline gap-2">
							<span class={`text-2xl font-bold ${pricing.soldOut ? 'text-gray-400 line-through' : dark ? 'text-white' : 'text-gray-800'}`}>${pricing.discountedPrice.toLocaleString()}</span>
							<span class={origPriceClass}>${pricing.originalPrice.toLocaleString()}</span>
							{!pricing.soldOut && <span class={savingsClass}>Save ${pricing.discountAmount.toLocaleString()}</span>}
						</div>
					</>
				) : (
					<>
						{pricing.remaining !== undefined && (
							<div class="mb-1">
								<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">{pricing.remaining} remaining</span>
							</div>
						)}
						<div class="flex items-baseline gap-2">
							<span class={`text-2xl font-bold ${pricing.soldOut ? 'text-gray-400 line-through' : dark ? 'text-white' : 'text-gray-800'}`}>${pricing.discountedPrice.toLocaleString()}</span>
						</div>
					</>
				)}
			</div>
		)}

		<div class="space-y-2 mb-6">
			{specs.map((spec) => (
				<div class="flex justify-between text-base">
					<span class={specLabelClass}>{spec.label}:</span>
					<span class={specValueClass} set:html={spec.value}></span>
				</div>
			))}
		</div>

		{!isAllSoldOut && (
			<a href={ctaHref} class={ctaClass}>
				{ctaLabel} →
			</a>
		)}
	</div>
</div>
