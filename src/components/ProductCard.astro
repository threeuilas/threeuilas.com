---
import ProductCarousel from './ProductCarousel.astro';

interface Spec {
	label: string;
	value: string;
}

interface Pricing {
	originalPrice: number;
	discountedPrice: number;
	discountAmount: number;
	soldOut?: boolean;
	remaining?: number;
}

interface DualPricing {
	withDumpBed: Pricing;
	withoutDumpBed: Pricing;
}

interface Props {
	name: string;
	description: string;
	specs: Spec[];
	images: string | string[];
	alt?: string;
	learnMoreLink?: string;
	pricing?: Pricing | DualPricing;
	comingSoon?: boolean;
	preorder?: boolean;
}

const {
	name,
	description,
	specs,
	images,
	alt = name,
	learnMoreLink = '/contact',
	pricing,
	comingSoon = false,
	preorder = false
} = Astro.props;

const isMultipleImages = Array.isArray(images);
const hasDualPricing = pricing && 'withDumpBed' in pricing;
---

<div class="bg-white border border-gray-200 rounded-lg overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
	{comingSoon ? (
		<div class="w-full aspect-[4/3] bg-[#FDFDFC] flex items-center justify-center border-b border-gray-200">
			<div class="text-center px-6">
				<p class="text-3xl font-bold text-[#DB1100] mb-2">Coming Soon!</p>
				<p class="text-lg text-gray-600">Stay tuned for updates</p>
			</div>
		</div>
	) : preorder ? (
		<div class="w-full aspect-[4/3] bg-[#FDFDFC] flex items-center justify-center border-b border-gray-200">
			<div class="text-center px-6">
				<p class="text-3xl font-bold text-[#DB1100] mb-1">Preorder Now</p>
				{pricing && !('withDumpBed' in pricing) && pricing.discountAmount > 0 && (
					<p class="text-3xl font-bold text-[#DB1100] mb-2">Save ${pricing.discountAmount.toLocaleString()}</p>
				)}
				<p class="text-lg text-gray-600"><a href="/contact" class="underline hover:text-[#DB1100] transition-colors">Contact us</a> to preorder yours today</p>
			</div>
		</div>
	) : isMultipleImages ? (
		<ProductCarousel 
			images={images}
			alt={alt}
		/>
	) : (
		<img 
			src={images} 
			alt={alt} 
			class="w-full aspect-[4/3] object-cover"
			loading="lazy"
			decoding="async"
		/>
	)}
	<div class="p-6 flex flex-col flex-1">
		<div class="flex items-center gap-3 mb-3">
			<h3 class="text-2xl font-semibold text-gray-800">{name}</h3>
			{comingSoon ? (
				<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Coming Soon</span>
			) : preorder ? (
				<span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">Preorder</span>
			) : (
				<span class="bg-green-100 text-green-800 text-xs font-semibold px-2.5 py-1 rounded uppercase tracking-wide">In Stock</span>
			)}
		</div>
		<p class="text-base md:text-lg text-gray-600 mb-6">{description}</p>
		
		{pricing && (
			<div class="mb-6 pb-6 border-b border-gray-200">
				{!hasDualPricing && pricing.discountAmount > 0 && (
					<div class="mb-2">
						<span class="text-base font-semibold text-[#DB1100] uppercase tracking-wide">{preorder ? `Save $${pricing.discountAmount.toLocaleString()} with 50% preorder deposit` : 'Early Bird Discount'}</span>
					</div>
				)}
				{hasDualPricing && (
					<div class="mb-2">
						<span class="text-base font-semibold text-[#DB1100] uppercase tracking-wide">Early Bird Discount</span>
					</div>
				)}
				{hasDualPricing ? (
					<div class="space-y-4">
						<div>
							<div class="flex items-baseline gap-2 mb-1">
								<span class="text-base text-gray-600">With Hydraulic Auto-dump Bed:</span>
								{pricing.withDumpBed.soldOut && (
									<span class="bg-red-100 text-red-700 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">Sold Out</span>
								)}
							</div>
							<div class="flex items-baseline gap-2">
								<span class={`text-2xl font-bold ${pricing.withDumpBed.soldOut ? 'text-gray-400 line-through' : 'text-gray-800'}`}>${pricing.withDumpBed.discountedPrice.toLocaleString()}</span>
								<span class="text-lg text-gray-400 line-through">${pricing.withDumpBed.originalPrice.toLocaleString()}</span>
								{!pricing.withDumpBed.soldOut && (
									<span class="text-base font-medium text-[#DB1100]">Save ${pricing.withDumpBed.discountAmount}</span>
								)}
							</div>
						</div>
						<div>
							<div class="flex items-baseline gap-2 mb-1">
								<span class="text-base text-gray-600">With Standard Bed:</span>
								{pricing.withoutDumpBed.remaining !== undefined && (
									<span class="bg-yellow-100 text-yellow-800 text-xs font-semibold px-2 py-0.5 rounded uppercase tracking-wide">{pricing.withoutDumpBed.remaining} remaining</span>
								)}
							</div>
							<div class="flex items-baseline gap-2">
								<span class="text-2xl font-bold text-gray-800">${pricing.withoutDumpBed.discountedPrice.toLocaleString()}</span>
								<span class="text-lg text-gray-400 line-through">${pricing.withoutDumpBed.originalPrice.toLocaleString()}</span>
								<span class="text-base font-medium text-[#DB1100]">Save ${pricing.withoutDumpBed.discountAmount.toLocaleString()}</span>
							</div>
						</div>
					</div>
				) : pricing.discountAmount > 0 ? (
					<div class="flex items-baseline gap-2">
						<span class="text-2xl font-bold text-gray-800">${pricing.discountedPrice.toLocaleString()}</span>
						<span class="text-lg text-gray-400 line-through">${pricing.originalPrice.toLocaleString()}</span>
						<span class="text-base font-medium text-[#DB1100]">Save ${pricing.discountAmount.toLocaleString()}</span>
					</div>
				) : (
					<div class="flex items-baseline gap-2">
						<span class="text-2xl font-bold text-gray-800">${pricing.discountedPrice.toLocaleString()}</span>
					</div>
				)}
			</div>
		)}
		
		<div class="space-y-2 mb-6">
			{specs.map((spec) => (
				<div class="flex justify-between text-base">
					<span class="text-gray-600">{spec.label}:</span>
					<span class="font-medium text-gray-800 text-right" set:html={spec.value}></span>
				</div>
			))}
		</div>
		
		<a href={learnMoreLink} class="text-[#DB1100] hover:text-[#DB1100]/80 text-base font-medium inline-flex items-center mt-auto">
			Learn more →
		</a>
	</div>
</div>
