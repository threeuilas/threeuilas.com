---
interface Props {
	colors: readonly { name: string; hex: string }[];
}

const { colors } = Astro.props;
---

<div class="product-colors">
	<h3>Available colors</h3>
	<ul role="list" aria-label="Available colors">
		{colors.map(color => (
			<li title={color.name}>
				<span class="swatch" style={{ '--swatch-color': color.hex }} aria-hidden="true"></span>
				<span class="color-name">{color.name}</span>
			</li>
		))}
	</ul>
</div>

<style>
	.product-colors { margin-top: 24px; }
	h3 { font-size: 20px; font-weight: 600; line-height: 1.3; margin-bottom: 12px; }
	ul { display: flex; flex-wrap: wrap; gap: 10px; padding: 0; margin: 0; list-style: none; }
	li { display: flex; }
	.swatch { display: block; width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgb(37 42 34 / 15%); background: var(--swatch-color); }
	.color-name { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
</style>
