---
import WorkhorsePhoto from './WorkhorsePhoto.astro';
import { workhorseFeatures } from '../data/workhorse-pro';
---

<div class="feature-explorer" data-feature-explorer>
	<div class="feature-links" aria-label="Explore Workhorse Pro features">
		{workhorseFeatures.map((feature, index) => (
			<a href={`#feature-${feature.id}`} id={`feature-link-${feature.id}`} data-feature-link>
				<span class="feature-number" aria-hidden="true">0{index + 1}</span>{feature.label}
			</a>
		))}
		<span class="tab-indicator" aria-hidden="true"></span>
	</div>
	<div class="feature-panels">
	{workhorseFeatures.map(feature => (
		<section id={`feature-${feature.id}`} class="feature-panel" aria-labelledby={`feature-link-${feature.id}`} data-feature-panel>
			<div class="feature-lead">
				<WorkhorsePhoto name={feature.image} sizes="(max-width: 800px) 100vw, 65vw" />
				<div class="feature-copy">
					<p class="eyebrow">{feature.kicker}</p>
					<h3>{feature.title}</h3>
					<p>{feature.description}</p>
				</div>
			</div>
			<div class="feature-details">
				{feature.details.map(detail => (
					<article>
						<WorkhorsePhoto name={detail.image} sizes="(max-width: 600px) 100vw, 33vw" />
						<h4>{detail.title}</h4>
						<p>{detail.description}</p>
					</article>
				))}
			</div>
		</section>
	))}
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-feature-explorer]').forEach(explorer => {
		const links = Array.from(explorer.querySelectorAll<HTMLAnchorElement>('[data-feature-link]'));
		const panels = Array.from(explorer.querySelectorAll<HTMLElement>('[data-feature-panel]'));
		const list = explorer.querySelector<HTMLElement>('.feature-links');
		const panelHost = explorer.querySelector<HTMLElement>('.feature-panels');
		if (!list || !panelHost || links.length !== panels.length) return;
		list.setAttribute('role', 'tablist');
		list.dataset.enhanced = 'true';
		let activeIndex = -1;
		let animations: Animation[] = [];
		const activate = (index: number, focus = false) => {
			if (focus) links[index].focus();
			if (index === activeIndex) return;
			animations.forEach(animation => animation.cancel());
			animations = [];
			const previousHeight = panelHost.getBoundingClientRect().height;
			const shouldAnimate = activeIndex >= 0 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			links.forEach((link, i) => {
				link.setAttribute('aria-selected', String(i === index));
				link.tabIndex = i === index ? 0 : -1;
				panels[i].hidden = i !== index;
			});
			list.style.setProperty('--tab-index', String(index));
			activeIndex = index;
			if (shouldAnimate) {
				const panel = panels[index];
				const nextHeight = panelHost.getBoundingClientRect().height;
				const image = panel.querySelector('.feature-lead > img');
				const copy = panel.querySelector('.feature-copy');
				const easing = 'cubic-bezier(0.22, 1, 0.36, 1)';
				animations.push(panelHost.animate([{ height: `${previousHeight}px`, overflow: 'clip' }, { height: `${nextHeight}px`, overflow: 'clip' }], { duration: 420, easing }));
				if (image) animations.push(image.animate([{ opacity: .35, transform: 'scale(1.035)' }, { opacity: 1, transform: 'scale(1)' }], { duration: 600, easing }));
				if (copy) animations.push(copy.animate([{ opacity: 0, transform: 'translateY(16px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 420, delay: 65, fill: 'backwards', easing }));
				panel.querySelectorAll('.feature-details article').forEach((article, i) => {
					animations.push(article.animate([{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 380, delay: 100 + i * 65, fill: 'backwards', easing }));
				});
			}
		};
		links.forEach((link, index) => {
			link.setAttribute('role', 'tab');
			link.setAttribute('aria-controls', panels[index].id);
			panels[index].setAttribute('role', 'tabpanel');
			panels[index].tabIndex = 0;
			link.addEventListener('click', event => {
				event.preventDefault();
				activate(index);
			});
			link.addEventListener('keydown', event => {
				let next = index;
				if (event.key === 'ArrowRight') next = (index + 1) % links.length;
				else if (event.key === 'ArrowLeft') next = (index - 1 + links.length) % links.length;
				else if (event.key === 'Home') next = 0;
				else if (event.key === 'End') next = links.length - 1;
				else return;
				event.preventDefault();
				activate(next, true);
			});
		});
		const initial = panels.findIndex(panel => `#${panel.id}` === window.location.hash);
		activate(initial < 0 ? 0 : initial);
	});
</script>

<style>
	.feature-links { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid #cfcec7; border-bottom: 1px solid #cfcec7; margin-bottom: 32px; }
	.feature-links a { flex: 1; display: flex; align-items: center; gap: 14px; padding: 23px 20px; color: #585b53; font-size: 22px; font-weight: 600; text-decoration: none; transition: color 220ms; }
	.feature-links a:first-child { padding-left: 0; }
	.feature-links a[aria-selected='true'] { color: #20251e; }
	.tab-indicator { display: none; position: absolute; bottom: -1px; left: 0; width: calc(100% / 3); height: 3px; background: #db1100; transform: translateX(calc(var(--tab-index, 0) * 100%)); transition: transform 420ms cubic-bezier(.22, 1, .36, 1); pointer-events: none; }
	.feature-links[data-enhanced] .tab-indicator { display: block; }
	.feature-panels { display: flow-root; }
	.feature-number { color: #b80e00; font-size: 13px; font-family: system-ui, sans-serif; }
	.feature-panel { scroll-margin-top: 90px; margin-bottom: 48px; }
	.feature-panel[hidden] { display: none; }
	.feature-panel:last-child { margin-bottom: 0; }
	.feature-lead { display: grid; grid-template-columns: 1.65fr 1fr; background: #e8e8df; overflow: hidden; }
	.feature-lead > :global(img) { width: 100%; height: 100%; min-height: 410px; object-fit: cover; }
	.feature-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(28px, 4vw, 64px); }
	.eyebrow { font-family: system-ui, sans-serif; font-size: 10px; font-weight: 650; letter-spacing: .11em; text-transform: uppercase; color: #565b50; }
	h3 { font-size: clamp(38px, 3.4vw, 54px); font-weight: 700; line-height: 1.05; margin: 20px 0; }
	.feature-copy > p:not(.eyebrow), .feature-details p { font-family: system-ui, sans-serif; font-size: 14px; line-height: 1.8; color: #50564c; }
	.feature-details { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-top: 32px; }
	.feature-details :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
	.feature-details article:first-child :global(img) { object-position: center 57%; }
	h4 { font-size: 25px; font-weight: 600; margin: 20px 0 9px; line-height: 1.15; }
	a:focus-visible, .feature-panel:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
	@media (max-width: 800px) {
		.feature-lead { grid-template-columns: 1fr; }
		.feature-lead > :global(img) { min-height: 0; aspect-ratio: 3 / 2; }
		.feature-copy { padding: 32px; }
		.feature-links a { font-size: 18px; gap: 8px; padding: 20px 12px; }
		.feature-details { gap: 20px; }
	}
	@media (max-width: 600px) {
		.feature-number { display: none; }
		.feature-links a { font-size: 17px; padding: 20px 8px; justify-content: center; }
		.feature-links a:first-child { padding-left: 8px; }
		.feature-details { grid-template-columns: 1fr; gap: 30px; }
		.feature-details :global(img) { aspect-ratio: 16 / 10; }
		.feature-copy { padding: 28px 24px; }
		h3 { font-size: 42px; }
	}
	@media (prefers-reduced-motion: reduce) { .tab-indicator, .feature-links a { transition: none; } }
</style>
