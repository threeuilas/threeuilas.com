---
import WorkhorsePhoto from './WorkhorsePhoto.astro';
import SparrowPhoto from './SparrowPhoto.astro';
import type { availableProducts } from '../data/products';

interface Props { product: typeof availableProducts[number]; detailed?: boolean; }
const { product, detailed = false } = Astro.props;
const pro = product.name === 'Three Uilas Workhorse Pro';
const name = product.name.replace('Three Uilas ', '');
const spec = (label: string) => product.specs.find(item => item.label === label)?.value;
const href = product.learnMoreLink;
---

<article class="model-preview" id={pro ? 'workhorse-pro' : 'sparrow-plus'}>
	<figure>
		<a href={href} aria-label={`Explore ${name}`}>
			{pro ? <WorkhorsePhoto name="cabin-front-wide" sizes="(max-width: 700px) 100vw, 50vw" /> : <SparrowPhoto name="side-front" sizes="(max-width: 700px) 100vw, 50vw" />}
		</a>
		<figcaption>{name}</figcaption>
	</figure>
	<div class="model-heading"><div><p class="model-category">{pro ? 'For hauling & farm work' : 'For lighter loads & everyday trips'}</p><h3>{name}</h3></div><p class="model-price">${product.pricing.discountedPrice.toLocaleString('en-US')}</p></div>
	<p class="body-copy model-description">{pro ? 'A five-foot steel bed, hydraulic lift, and our largest lithium battery.' : 'Compact electric utility with a foldable rear seat and a 4.7 kWh lithium battery.'}</p>
	<dl class="model-stats">
		<div><dt>Motor</dt><dd>{spec('Motor')}</dd></div>
		<div><dt>Battery</dt><dd>{spec('Battery Capacity')}</dd></div>
		<div><dt>Range, up to*</dt><dd>{spec('Maximum Range')}</dd></div>
	</dl>
	{detailed && <p class="model-inclusions">{pro ? 'Hydraulic dump bed · Roof & windscreen · Tow hitch' : 'Foldable rear seat · 3 ft 6 in bed · Plug-in wall charger'}</p>}
	<a href={href} class="action action--outline">Explore {name}</a>
</article>

<style>
	.model-preview { scroll-margin-top: 24px; }
	figure { position: relative; overflow: hidden; background: #dfe3d6; }
	figure > a { display: block; }
	figure :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; transition: transform 500ms ease; }
	figure:hover :global(img) { transform: scale(1.025); }
	figcaption { position: absolute; bottom: 0; left: 0; right: 0; padding: 30px 20px 16px; background: linear-gradient(transparent, #152110ce); color: #fff; font: 10px/1.6 system-ui, sans-serif; pointer-events: none; }
	.model-heading { display: flex; justify-content: space-between; align-items: end; gap: 20px; margin: 27px 0 16px; }
	.model-category { font: 500 10px/1.6 system-ui, sans-serif; text-transform: uppercase; letter-spacing: .08em; color: #656f5b; margin-bottom: 7px; }
	h3 { font-size: clamp(34px, 3.2vw, 48px); font-weight: 700; letter-spacing: -.025em; line-height: 1; }
	.model-price { font-size: 32px; font-weight: 600; line-height: 1.1; }
	.model-description { min-height: 52px; max-width: 450px; }
	.model-stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 25px 0; padding-block: 22px; border-block: 1px solid #cdd3c3; gap: 18px; }
	.model-stats dt { font: 11px/1.6 system-ui, sans-serif; color: #656f5b; margin-bottom: 8px; }
	.model-stats dd { font-size: 25px; font-weight: 500; }
	.model-inclusions { font: 11px/1.8 system-ui, sans-serif; color: #62695b; margin: -4px 0 24px; }
	a:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
	@media (max-width: 850px) { .model-price { font-size: 27px; } .model-stats { gap: 12px; } .model-stats dd { font-size: 22px; } }
	@media (max-width: 700px) { .model-heading { margin-top: 23px; } .model-description { min-height: 0; } h3 { font-size: 40px; } .model-price { font-size: 31px; } }
	@media (prefers-reduced-motion: reduce) { figure :global(img) { transition: none; } }
</style>
