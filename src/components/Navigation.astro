---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const onProducts = currentPath.startsWith('/products');
---

<header class="site-header">
	<div class="site-width header-inner">
		<a href="/" class="brand" aria-label="Three Uilas home"><img src="/logo.svg" alt="" width="46" height="46" /><span>Three Uilas</span></a>
		<button id="mobile-menu-button" class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open navigation"><span></span><span></span></button>
		<nav id="site-navigation" class="header-nav" aria-label="Main navigation">
			<div class="nav-content">
			<details class="products-disclosure" data-disclosure>
				<summary class:list={[onProducts && 'is-current']}>Products <svg class="disclosure-indicator disclosure-chevron" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></summary>
				<div class="products-dropdown" data-disclosure-content><div class="products-dropdown-inner">
					<p>Electric utility tricycles</p>
					<a href="/products" aria-current={currentPath === '/products' ? 'page' : undefined}>All models <span>Compare the range</span></a>
					<a href="/products/workhorse-pro" aria-current={currentPath === '/products/workhorse-pro' ? 'page' : undefined}>Workhorse Pro <span>Electric hauling with a hydraulic bed</span></a>
					<a href="/products/sparrow-plus" aria-current={currentPath === '/products/sparrow-plus' ? 'page' : undefined}>Sparrow+ <span>Compact utility with a lithium battery</span></a>
				</div></div>
			</details>
			<a href="/about" class:list={['story-link', currentPath === '/about' && 'is-current']} aria-current={currentPath === '/about' ? 'page' : undefined}>Our story</a>
			<a href="/contact" class="action header-contact" aria-current={currentPath === '/contact' ? 'page' : undefined}>Get in touch</a>
			</div>
		</nav>
	</div>
</header>

<script>
	import { setDisclosureOpen } from '../scripts/disclosures';
	const header = document.querySelector<HTMLElement>('.site-header');
	const button = document.querySelector<HTMLButtonElement>('#mobile-menu-button');
	const navigation = document.querySelector<HTMLElement>('#site-navigation');
	const products = document.querySelector<HTMLDetailsElement>('.products-disclosure');
	if (header && button && navigation && products) {
		header.dataset.enhanced = 'true';
		const mobile = window.matchMedia('(max-width: 700px)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let menuAnimation: Animation | null = null;
		const setNavigationOpen = (open: boolean, animate = true) => {
			const wasOpen = navigation.hasAttribute('data-open');
			const startHeight = wasOpen ? navigation.getBoundingClientRect().height : 0;
			const startOpacity = wasOpen ? getComputedStyle(navigation).opacity : '0';
			menuAnimation?.cancel();
			menuAnimation = null;
			button.setAttribute('aria-expanded', String(open));
			button.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
			navigation.inert = mobile.matches && !open;
			if (!mobile.matches || !animate || reducedMotion.matches || (!wasOpen && !open)) {
				navigation.toggleAttribute('data-open', open);
				return;
			}
			navigation.setAttribute('data-open', '');
			const endHeight = open ? navigation.getBoundingClientRect().height : 0;
			const animation = navigation.animate([
				{ height: `${startHeight}px`, opacity: startOpacity, overflow: 'clip' },
				{ height: `${endHeight}px`, opacity: open ? '1' : '0', overflow: 'clip' },
			], { duration: open ? 340 : 280, easing: 'cubic-bezier(.22, 1, .36, 1)' });
			menuAnimation = animation;
			animation.onfinish = () => {
				if (menuAnimation !== animation) return;
				menuAnimation = null;
				navigation.toggleAttribute('data-open', open);
				animation.cancel();
			};
		};
		const closeNavigation = () => setNavigationOpen(false);
		navigation.inert = mobile.matches;
		mobile.addEventListener('change', () => setNavigationOpen(false, false));
		reducedMotion.addEventListener('change', () => {
			if (reducedMotion.matches) setNavigationOpen(button.getAttribute('aria-expanded') === 'true', false);
		});
		button.addEventListener('click', () => {
			const open = button.getAttribute('aria-expanded') !== 'true';
			setNavigationOpen(open);
		});
		document.addEventListener('click', event => {
			if (event.target instanceof Node && !header.contains(event.target)) {
				setDisclosureOpen(products, false);
				closeNavigation();
			}
		});
		document.addEventListener('keydown', event => {
			if (event.key !== 'Escape') return;
			if (products.open && products.dataset.expanded !== 'false') {
				setDisclosureOpen(products, false);
				products.querySelector('summary')?.focus();
			} else if (navigation.hasAttribute('data-open')) {
				closeNavigation();
				button.focus();
			}
		});
		navigation.querySelectorAll('a').forEach(link => link.addEventListener('click', () => {
			setDisclosureOpen(products, false);
			closeNavigation();
		}));
	}
</script>

<style>
	.site-header { position: relative; z-index: 60; background: #f5f4ef; border-bottom: 1px solid #d4d8cb; }
	.header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 88px; gap: 32px; }
	.brand { display: inline-flex; align-items: center; gap: 13px; text-decoration: none; flex-shrink: 0; }
	.brand img { width: 46px; height: 46px; }
	.brand span { font-size: 30px; font-weight: 800; letter-spacing: -.03em; }
	.nav-content { display: flex; align-items: center; gap: 42px; }
	.products-disclosure { position: relative; }
	.products-disclosure summary, .story-link { font-size: 18px; font-weight: 600; cursor: pointer; }
	.products-disclosure summary { display: flex; align-items: center; gap: 10px; list-style: none; padding: 20px 0; }
	.products-disclosure summary::-webkit-details-marker { display: none; }
	.is-current { color: #b80e00; }
	.products-dropdown { position: absolute; top: calc(100% + 8px); right: -24px; width: 340px; }
	.products-dropdown-inner { padding: 24px; background: #f5f4ef; border: 1px solid #d4d8cb; box-shadow: 0 14px 35px #16211118; }
	.products-dropdown-inner > p { font: 600 9px/1.6 system-ui, sans-serif; letter-spacing: .12em; text-transform: uppercase; color: #717968; margin-bottom: 14px; }
	.products-dropdown a { display: block; padding: 14px 0; font-size: 23px; font-weight: 600; border-top: 1px solid #d4d8cb; }
	.products-dropdown a span { display: block; margin-top: 5px; font: 11px/1.6 system-ui, sans-serif; color: #62695b; }
	.products-dropdown a:hover, .products-dropdown a[aria-current='page'], .story-link:hover { color: #b80e00; }
	.menu-toggle { display: none; width: 44px; height: 44px; cursor: pointer; }
	.menu-toggle span { display: block; width: 24px; height: 1.5px; background: #252a22; margin: 6px auto; transition: transform 180ms; }
	a:focus-visible, summary:focus-visible, button:focus-visible { outline: 3px solid #b80e00; outline-offset: 5px; }
	@media (max-width: 700px) {
		.header-inner { min-height: 74px; flex-wrap: wrap; gap: 0 20px; }
		.brand span { font-size: 27px; }
		.brand img { width: 39px; height: 39px; }
		.site-header[data-enhanced] .menu-toggle { display: block; }
		.site-header[data-enhanced] .header-nav:not([data-open]) { display: none; }
		.menu-toggle[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
		.menu-toggle[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
		.header-nav { width: 100%; }
		.nav-content { width: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: 0 0 24px; }
		.products-disclosure summary, .story-link { padding: 20px 0; border-top: 1px solid #d4d8cb; }
		.products-disclosure summary { justify-content: space-between; }
		.products-dropdown { position: static; width: 100%; }
		.products-dropdown-inner { padding: 0 0 16px 18px; border: 0; box-shadow: none; }
		.products-dropdown-inner > p { display: none; }
		.products-dropdown a { font-size: 22px; }
		.products-dropdown a:first-of-type { border-top: 0; }
		.header-contact { align-self: start; margin-top: 6px; }
	}
	@media (prefers-reduced-motion: reduce) { .menu-toggle span { transition: none; } }
</style>
